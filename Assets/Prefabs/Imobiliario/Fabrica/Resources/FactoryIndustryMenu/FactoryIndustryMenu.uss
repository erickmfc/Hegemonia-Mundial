.factory-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 8, 12, 0.52);
    padding: 26px;
}

.factory-panel {
    position: relative;
    width: 1120px;
    max-width: 88%;
    max-height: 84%;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 22px;
    padding-bottom: 20px;
    background-color: rgb(16, 20, 24);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(175, 132, 68, 0.28);
    border-right-color: rgba(175, 132, 68, 0.28);
    border-top-color: rgba(175, 132, 68, 0.28);
    border-bottom-color: rgba(175, 132, 68, 0.28);
}

.factory-panel-glow {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 10px;
    height: 120px;
    background-color: rgba(197, 128, 52, 0.08);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 100px;
    border-bottom-right-radius: 100px;
}

.factory-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.factory-header-copy {
    flex-grow: 1;
    padding-right: 16px;
}

.factory-title {
    color: rgb(241, 236, 222);
    font-size: 27px;
    -unity-font-style: bold;
}

.factory-subtitle {
    margin-top: 5px;
    color: rgb(167, 173, 170);
    font-size: 12px;
    letter-spacing: 1px;
}

.factory-status {
    margin-top: 8px;
    color: rgb(223, 189, 121);
    font-size: 12px;
}

.factory-close {
    min-width: 124px;
    height: 38px;
    color: rgb(252, 243, 225);
    background-color: rgb(89, 58, 34);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(221, 161, 74, 0.26);
    border-right-color: rgba(221, 161, 74, 0.26);
    border-top-color: rgba(221, 161, 74, 0.26);
    border-bottom-color: rgba(221, 161, 74, 0.26);
}

.factory-summary {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.factory-summary-chip {
    margin-right: 8px;
    margin-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    color: rgb(225, 226, 221);
    background-color: rgb(28, 33, 38);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    font-size: 11px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.04);
    border-right-color: rgba(255, 255, 255, 0.04);
    border-top-color: rgba(255, 255, 255, 0.04);
    border-bottom-color: rgba(255, 255, 255, 0.04);
}

.factory-summary-chip.is-primary {
    background-color: rgb(52, 44, 29);
    color: rgb(247, 217, 160);
}

.factory-summary-chip.is-accent {
    background-color: rgb(36, 50, 47);
    color: rgb(176, 225, 210);
}

.factory-body {
    flex-direction: row;
    min-height: 520px;
}

.factory-highlight {
    width: 390px;
    margin-right: 18px;
    padding: 18px;
    background-color: rgb(22, 26, 31);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(209, 150, 73, 0.18);
    border-right-color: rgba(209, 150, 73, 0.18);
    border-top-color: rgba(209, 150, 73, 0.18);
    border-bottom-color: rgba(209, 150, 73, 0.18);
}

.factory-highlight.is-idle {
    border-left-color: rgba(112, 118, 125, 0.18);
    border-right-color: rgba(112, 118, 125, 0.18);
    border-top-color: rgba(112, 118, 125, 0.18);
    border-bottom-color: rgba(112, 118, 125, 0.18);
}

.factory-highlight-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.factory-highlight-name {
    color: rgb(245, 238, 222);
    font-size: 24px;
    -unity-font-style: bold;
}

.factory-highlight-state {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgb(69, 57, 34);
    color: rgb(255, 223, 162);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    font-size: 11px;
}

.factory-highlight-summary {
    margin-top: 12px;
    color: rgb(195, 196, 190);
    font-size: 12px;
    white-space: normal;
}

.factory-highlight-flow {
    margin-top: 8px;
    margin-bottom: 14px;
    color: rgb(144, 170, 166);
    font-size: 12px;
    white-space: normal;
}

.factory-highlight-metrics {
    flex-direction: row;
    flex-wrap: wrap;
}

.factory-list {
    flex-grow: 1;
    min-height: 520px;
}

.factory-mineral-card {
    margin-bottom: 10px;
    padding: 14px;
    background-color: rgb(25, 29, 34);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.factory-mineral-card:hover {
    background-color: rgb(31, 36, 42);
}

.factory-mineral-card.is-selected {
    background-color: rgb(41, 34, 24);
    border-left-color: rgba(226, 165, 73, 0.34);
    border-right-color: rgba(226, 165, 73, 0.34);
    border-top-color: rgba(226, 165, 73, 0.34);
    border-bottom-color: rgba(226, 165, 73, 0.34);
}

.factory-mineral-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.factory-mineral-name {
    color: rgb(242, 240, 233);
    font-size: 18px;
    -unity-font-style: bold;
}

.factory-mineral-state {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    background-color: rgb(48, 53, 59);
    color: rgb(214, 217, 219);
    font-size: 10px;
}

.factory-mineral-state.is-good {
    background-color: rgb(35, 83, 65);
    color: rgb(184, 245, 219);
}

.factory-mineral-state.is-warn {
    background-color: rgb(105, 76, 31);
    color: rgb(255, 226, 172);
}

.factory-mineral-state.is-bad {
    background-color: rgb(102, 45, 45);
    color: rgb(255, 203, 203);
}

.factory-mineral-subtitle {
    margin-top: 8px;
    margin-bottom: 10px;
    color: rgb(155, 160, 163);
    font-size: 11px;
    white-space: normal;
}

.factory-mineral-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.factory-metric {
    width: 112px;
    min-height: 62px;
    margin-right: 8px;
    margin-bottom: 8px;
    padding: 9px;
    background-color: rgb(15, 18, 22);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.factory-metric.compact {
    width: 126px;
    min-height: 54px;
}

.factory-metric.accent-copper {
    background-color: rgb(54, 37, 24);
}

.factory-metric.accent-gold {
    background-color: rgb(62, 53, 29);
}

.factory-metric.accent-steel {
    background-color: rgb(28, 44, 50);
}

.factory-metric.accent-smoke {
    background-color: rgb(25, 31, 36);
}

.factory-metric-label {
    color: rgb(136, 143, 147);
    font-size: 10px;
}

.factory-metric-value {
    margin-top: 5px;
    color: rgb(243, 242, 236);
    font-size: 14px;
    -unity-font-style: bold;
}

.gov-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    padding: 55px 14px 12px 14px;
    align-items: center;
    justify-content: center;
    background-color: rgba(1, 8, 13, 0.95);
    color: rgb(239, 246, 249);
}

.unity-text-field__input,
.unity-integer-field__input {
    color: rgb(239, 246, 249);
    background-color: rgba(0, 0, 0, 0.4);
    border-color: rgba(54, 214, 220, 0.45);
    border-radius: 4px;
    padding: 4px;
}

.gov-shell {
    width: 98%;
    height: 95%;
    background-color: rgb(4, 16, 24);
    border-width: 1px;
    border-color: rgba(224, 177, 74, 0.45);
}

.gov-header { min-height: 96px; flex-direction: row; flex-wrap: wrap; align-items: center; padding: 12px 16px; border-bottom-width: 1px; border-bottom-color: rgba(54, 214, 220, 0.25); }
.gov-brand { flex-grow: 1; min-width: 0; flex-direction: row; align-items: center; }
.gov-flag { width: 66px; height: 44px; min-width: 66px; margin-right: 14px; overflow: hidden; border-width: 1px; border-color: rgba(245,247,250,0.75); }
.gov-flag-large { width: 260px; height: 156px; min-width: 220px; margin: 10px 0 16px 0; overflow: hidden; border-width: 2px; border-color: rgba(245,247,250,0.75); }
.gov-country-block { width: 330px; min-width: 160px; flex-shrink: 1; flex-direction: column; justify-content: center; }
.gov-country { height: 32px; flex-shrink: 0; font-size: 21px; -unity-font-style: bold; white-space: nowrap; }
.gov-meta, .gov-caption { margin-top: 5px; min-height: 17px; font-size: 12px; color: rgb(159,176,189); }
.gov-title { width: 210px; min-width: 120px; flex-shrink: 1; margin-left: 4px; margin-right: 12px; align-items: center; font-size: 23px; -unity-font-style: bold; }
.gov-title-accent { color: rgb(224,177,74); letter-spacing: 5px; font-size: 14px; }
.gov-status { width: 200px; min-width: 140px; flex-shrink: 1; margin-left: 8px; min-height: 64px; align-items: center; justify-content: center; border-width: 1px; border-color: rgba(54,214,220,0.45); background-color: rgba(5,27,38,0.9); }
.gov-status-value { margin-top: 3px; color: rgb(54,214,220); font-size: 25px; -unity-font-style: bold; }

.gov-resources { min-height: 80px; flex-direction: row; flex-wrap: wrap; border-bottom-width: 1px; border-bottom-color: rgba(90,202,211,0.2); }
.gov-resource-card { flex-grow: 1; flex-basis: 120px; min-width: 120px; padding: 12px 12px 10px 12px; justify-content: center; align-items: center; border-right-width: 1px; border-right-color: rgba(90,202,211,0.18); }
#resource-label { font-size: 10px; color: rgb(159,176,189); }
#resource-value { margin-top: 5px; font-size: 16px; -unity-font-style: bold; }
.gov-body { flex-grow: 1; min-height: 0; flex-direction: row; flex-wrap: wrap; padding: 12px; }
.gov-navigation { width: 206px; min-width: 150px; margin-right: 12px; background-color: rgb(5,19,28); border-width: 1px; border-color: rgba(90,202,211,0.2); }
.gov-workspace { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; flex-direction: column; }
.gov-tabs { height: 54px; flex-shrink: 0; background-color: rgb(3,17,25); border-width: 1px; border-color: rgba(90,202,211,0.25); }
.gov-tabs .unity-scroll-view__content-container { flex-direction: row; }
.gov-navigation .unity-scroll-view__content-container { flex-direction: column; }
.gov-content .unity-scroll-view__content-container { flex-direction: column; flex-shrink: 0; }
.gov-actions .unity-scroll-view__content-container { width: 100%; min-width: 0; flex-direction: column; flex-shrink: 1; }
.gov-page { flex-grow: 1; min-width: 0; min-height: 0; margin-top: 12px; flex-direction: row; flex-wrap: nowrap; }
.gov-content { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; min-height: 0; height: 100%; padding: 16px; background-color: rgb(3,13,21); border-width: 1px; border-color: rgba(90,202,211,0.22); }
.gov-actions { width: 410px; min-width: 340px; min-height: 0; height: 100%; flex-shrink: 0; margin-left: 12px; padding: 14px; background-color: rgb(5,18,27); border-width: 1px; border-color: rgba(90,202,211,0.22); }
.gov-footer { height: 48px; padding: 0 18px; flex-direction: row; align-items: center; justify-content: space-between; color: rgb(159,176,189); border-top-width: 1px; border-top-color: rgba(224,177,74,0.25); }
.gov-footer-path { color: rgb(54,214,220); }

.gov-nav-button { height: 58px; margin: 3px 6px; padding-left: 14px; -unity-text-align: middle-left; font-size: 14px; color: rgb(220,231,238); background-color: rgba(8,28,39,0.9); border-width: 0 0 0 3px; border-left-color: transparent; }
.gov-nav-button:hover, .gov-nav-button.active { color: rgb(54,214,220); background-color: rgba(22,150,162,0.2); border-left-color: rgb(54,214,220); }
.gov-tab-button { min-width: 142px; height: 52px; font-size: 13px; color: rgb(205,217,223); background-color: transparent; border-width: 0 1px 3px 0; border-right-color: rgba(90,202,211,0.18); border-bottom-color: transparent; }
.gov-tab-button:hover, .gov-tab-button.active { color: rgb(54,214,220); background-color: rgba(22,150,162,0.16); border-bottom-color: rgb(54,214,220); }
.gov-action-button { width: 100%; min-height: 44px; margin-bottom: 8px; padding: 7px 9px; white-space: normal; -unity-text-align: middle-center; font-size: 12px; color: rgb(213,235,239); background-image: none; background-color: rgba(10,35,47,0.92); border-width: 1px 1px 1px 3px; border-color: rgba(54,214,220,0.3); border-left-color: rgb(54,214,220); border-radius: 4px; }
.gov-action-button:hover { color: white; background-color: rgba(18,70,82,0.95); border-color: rgba(54,214,220,0.75); border-left-color: rgb(54,214,220); }
.gov-action-button:active { background-color: rgba(7,42,53,0.98); }
.gov-action-button:disabled { opacity: 0.48; color: rgb(159,176,189); }
.gov-action-button.buy { color: rgb(136,225,160); border-color: rgba(110,211,111,0.32); border-left-color: rgb(110,211,111); }
.gov-action-button.warning { color: rgb(248,208,121); border-color: rgba(248,196,84,0.32); border-left-color: rgb(248,196,84); }
.gov-action-button.danger { color: rgb(255,145,145); border-color: rgba(255,91,91,0.35); border-left-color: rgb(255,91,91); }
.gov-action-section { width: 100%; margin-bottom: 12px; padding: 12px; background-color: rgba(8,25,36,0.82); border-width: 1px; border-color: rgba(90,202,211,0.22); border-radius: 5px; }
.gov-action-section-title { margin-bottom: 6px; color: rgb(224,177,74); font-size: 12px; -unity-font-style: bold; letter-spacing: 0.5px; }
.gov-action-section-copy { margin-bottom: 8px; color: rgb(159,176,189); font-size: 11px; white-space: normal; }
.gov-action-grid { width: 100%; min-width: 0; flex-direction: row; align-items: stretch; flex-wrap: wrap; margin-top: 5px; }
.gov-action-option { width: auto; min-width: 120px; flex-basis: 150px; flex-grow: 1; min-height: 64px; margin: 0 5px 8px 0; padding: 8px; color: rgb(213,235,239); background-image: none; background-color: rgba(10,35,47,0.92); border-width: 1px; border-color: rgba(90,202,211,0.34); border-radius: 4px; font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.gov-action-option:hover { color: white; background-color: rgba(18,70,82,0.98); border-color: rgba(54,214,220,0.8); }
.gov-action-option:active { background-color: rgba(7,42,53,0.98); }
.gov-action-option:disabled { opacity: 0.48; color: rgb(159,176,189); }
.gov-action-option.buy { color: rgb(144,230,165); border-color: rgba(110,211,111,0.42); }
.gov-action-option.warning { color: rgb(248,208,121); border-color: rgba(248,196,84,0.42); }
.gov-action-option.danger { color: rgb(255,145,145); border-color: rgba(255,91,91,0.42); }
.gov-action-option.selected { color: white; background-image: none; background-color: rgba(24,123,131,0.85); border-color: rgba(54,214,220,0.9); }
.gov-investment-mode { width: auto; min-width: 145px; flex-basis: 170px; flex-grow: 1; min-height: 48px; margin: 0 5px 8px 0; padding: 8px; color: rgb(186,207,216); background-image: none; background-color: rgba(10,35,47,0.92); border-width: 1px; border-color: rgba(90,202,211,0.34); border-radius: 4px; font-size: 11px; -unity-font-style: bold; }
.gov-investment-mode.selected { color: rgb(255,232,176); background-color: rgba(123,90,31,0.58); border-color: rgba(224,177,74,0.88); }
.gov-investment-mode:hover { color: white; background-color: rgba(18,70,82,0.98); }
.gov-action-wide { width: 100%; min-height: 40px; margin-bottom: 0; font-size: 11px; }
.gov-action-notice { margin: 3px 0 2px 0; padding: 7px 8px; color: rgb(248,196,84); background-color: rgba(248,196,84,0.07); border-width: 1px; border-color: rgba(248,196,84,0.24); font-size: 10px; white-space: normal; }
.gov-culture-control { margin-bottom: 12px; padding: 12px; background-color: rgba(6,23,33,0.9); border-width: 1px; border-color: rgba(54,214,220,0.22); }
.gov-culture-select { min-height: 42px; margin-bottom: 10px; color: rgb(220,231,238); font-size: 12px; }
.gov-culture-select .unity-base-field__label { color: rgb(159,176,189); font-size: 10px; -unity-font-style: bold; }
.gov-culture-select .unity-base-field__input,
.gov-culture-select .unity-popup-field__input { min-height: 32px; color: rgb(239,246,249); background-color: rgb(7,28,39); border-width: 1px; border-color: rgba(54,214,220,0.5); border-radius: 4px; }
.gov-culture-select .unity-popup-field__text { color: rgb(239,246,249); }
.gov-culture-select .unity-popup-field__arrow { -unity-background-image-tint-color: rgb(54,214,220); }
.gov-share-row { flex-direction: row; align-items: center; margin-bottom: 8px; }
.gov-share-slider { flex-grow: 1; min-width: 180px; min-height: 34px; margin-right: 12px; color: rgb(186,207,216); font-size: 11px; }
.gov-share-slider .unity-base-field__label { color: rgb(159,176,189); font-size: 10px; }
.gov-share-slider .unity-base-slider__input { min-height: 24px; }
.gov-share-slider .unity-base-slider__tracker { height: 8px; background-color: rgba(54,214,220,0.2); border-radius: 4px; }
.gov-share-slider .unity-base-slider__dragger { width: 18px; height: 18px; background-color: rgb(54,214,220); border-width: 2px; border-color: rgb(3,17,25); border-radius: 9px; }
.gov-share-value { width: 60px; color: rgb(54,214,220); font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-right; }
.gov-share-presets { flex-direction: row; margin: 2px 0 9px 0; }
.gov-share-preset { flex-grow: 1; min-width: 42px; min-height: 32px; margin-right: 6px; color: rgb(205,217,223); background-image: none; background-color: rgba(54,214,220,0.07); border-width: 1px; border-color: rgba(54,214,220,0.28); border-radius: 4px; font-size: 10px; -unity-font-style: bold; }
.gov-share-preset:hover { color: white; background-color: rgba(54,214,220,0.2); border-color: rgba(54,214,220,0.75); }
.gov-share-apply { width: 100%; min-height: 39px; color: rgb(239,246,249); background-image: none; background-color: rgba(22,110,128,0.82); border-width: 1px; border-color: rgba(54,214,220,0.72); -unity-font-style: bold; }
.gov-share-apply:hover { background-color: rgba(38,165,177,0.95); color: white; }
.gov-actions .gov-action-button { min-height: 46px; border-radius: 5px; font-size: 11px; -unity-font-style: bold; }
.gov-actions .gov-action-grid > .gov-action-option { width: auto; min-width: 0; flex-basis: 0; flex-grow: 1; flex-shrink: 1; min-height: 68px; margin-right: 4px; border-radius: 5px; font-size: 10px; white-space: normal; }
.gov-actions .gov-action-grid > .gov-investment-mode { width: auto; min-width: 0; flex-basis: 0; flex-grow: 1; flex-shrink: 1; margin-right: 4px; border-radius: 5px; }
.gov-action-section { border-left-width: 2px; border-left-color: rgba(54,214,220,0.4); }
.gov-card { margin-bottom: 12px; padding: 16px; background-color: rgba(255,255,255,0.025); border-width: 1px; border-color: rgba(90,202,211,0.2); }
.gov-budget-card { padding: 18px; border-left-width: 3px; border-left-color: rgba(54,214,220,0.64); background-color: rgba(8,28,39,0.82); }
.gov-budget-description { margin-bottom: 12px; color: rgb(159,176,189); font-size: 12px; white-space: normal; }
.gov-budget-toggle { min-height: 34px; margin-bottom: 8px; color: rgb(220,231,238); -unity-font-style: bold; }
.gov-budget-total-field { margin: 6px 0 8px 0; max-width: 320px; }
.gov-budget-summary { margin: 6px 0; color: rgb(245,247,250); font-size: 15px; -unity-font-style: bold; }
.gov-budget-status { margin: 2px 0 8px 0; color: rgb(224,177,74); font-size: 11px; }
.gov-budget-row { min-height: 46px; margin: 3px 0; padding: 5px 0; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: rgba(90,202,211,0.12); }
.gov-budget-name { width: 205px; min-width: 155px; color: rgb(220,231,238); font-size: 11px; -unity-font-style: bold; }
.gov-budget-slider { flex-grow: 1; min-width: 100px; margin: 0 12px; }
.gov-budget-value { width: 178px; min-width: 130px; -unity-text-align: middle-right; color: rgb(54,214,220); font-size: 11px; -unity-font-style: bold; }
.gov-identity-card { padding: 18px; border-left-width: 3px; border-left-color: rgba(224,177,74,0.75); }
.gov-identity-field { margin: 6px 0; max-width: 520px; }
.gov-identity-color { max-width: 520px; margin: 4px 0; }
.gov-heading { margin-bottom: 8px; font-size: 22px; -unity-font-style: bold; color: rgb(245,247,250); }
.gov-subheading { margin-bottom: 16px; font-size: 13px; color: rgb(159,176,189); white-space: normal; }
.gov-stat-grid { flex-direction: row; flex-wrap: wrap; margin-bottom: 12px; }
.gov-stat-card { flex-grow: 1; flex-basis: 160px; min-height: 92px; margin: 0 10px 10px 0; padding: 12px 14px; justify-content: center; background-color: rgba(255,255,255,0.025); border-width: 1px; border-color: rgba(54,214,220,0.18); }
.gov-stat-label { font-size: 11px; color: rgb(159,176,189); }
.gov-stat-value { margin-top: 4px; font-size: 24px; -unity-font-style: bold; }
.gov-table-row { flex-direction: row; align-items: center; min-height: 38px; border-bottom-width: 1px; border-bottom-color: rgba(54,214,220,0.12); }
.gov-table-row.header { background-color: rgba(255,255,255,0.03); border-bottom-color: rgba(224,177,74,0.22); }
.gov-table-cell { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 9px 10px; font-size: 12px; color: rgb(220,231,238); }
.gov-table-row.header .gov-table-cell { color: rgb(159,176,189); font-size: 11px; }
.gov-row-button { min-height: 30px; margin: 4px 8px 4px 0; }
.gov-row-button { color: rgb(239,246,249); background-color: rgba(22,110,128,0.82); border-width: 1px; border-color: rgba(54,214,220,0.72); -unity-font-style: bold; }
.gov-row-button:hover { background-color: rgba(38,165,177,0.95); color: white; }
.gov-row-button:active { background-color: rgba(8,65,78,0.95); }
.gov-row-action-cell:hover { background-color: rgba(54,214,220,0.12); color: white; }
.gov-market-filters { flex-direction: row; flex-wrap: wrap; align-items: center; margin: 0 0 12px 0; padding: 8px 10px; background-color: rgba(54,214,220,0.06); border-width: 1px; border-color: rgba(54,214,220,0.24); }
.gov-market-filter-title { margin-right: 18px; color: rgb(224,177,74); font-size: 11px; -unity-font-style: bold; }
.gov-market-filter { min-height: 32px; margin-right: 18px; color: rgb(220,231,238); font-size: 12px; }
.gov-market-filter:hover { color: rgb(54,214,220); }
.gov-market-filter .unity-toggle__input { margin-right: 7px; }
.gov-market-category-filters { flex-direction: row; flex-wrap: wrap; flex-grow: 1; margin-top: 5px; }
.gov-market-category-filters .gov-market-filter { margin-right: 8px; padding: 4px 9px; background-color: rgba(255,255,255,0.06); border-width: 1px; border-color: rgba(255,255,255,0.12); }
.gov-market-category-filters .gov-market-filter.active { color: rgb(54,214,220); background-color: rgba(54,214,220,0.16); border-color: rgba(54,214,220,0.60); }
.gov-market-grid { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.gov-market-card { flex-grow: 1; flex-shrink: 0; flex-basis: 360px; min-width: 0; margin: 0 10px 10px 0; padding: 14px; background-color: rgba(255,255,255,0.025); border-width: 1px; border-color: rgba(90,202,211,0.18); }
.gov-card-title { margin-bottom: 6px; font-size: 16px; -unity-font-style: bold; color: rgb(54,214,220); }
.gov-market-details { margin-bottom: 8px; color: rgb(190,205,214); font-size: 12px; white-space: normal; }
.gov-market-total { margin: 9px 0; color: rgb(245,247,250); font-size: 16px; -unity-font-style: bold; }
.gov-market-warning { margin-top: 8px; color: rgb(255,120,120); font-size: 11px; -unity-font-style: bold; }
.gov-quantity { margin-top: 8px; }
.gov-inline-actions { flex-direction: row; }
.gov-mini-button { flex-grow: 1; min-height: 32px; margin-right: 8px; font-size: 12px; color: rgb(54,214,220); background-color: rgba(255,255,255,0.03); border-color: rgba(54,214,220,0.45); }
.gov-mini-button.danger { color: rgb(255,120,120); border-color: rgba(255,91,91,0.55); }
.gov-mini-button.warning { color: rgb(248,196,84); border-color: rgba(248,196,84,0.55); }
.gov-mini-button.buy { color: rgb(110,211,111); border-color: rgba(110,211,111,0.65); }
.gov-science-grid { flex-direction: row; flex-wrap: wrap; margin-bottom: 12px; }
.gov-science-card { flex-grow: 1; flex-basis: 360px; margin: 0 10px 10px 0; padding: 14px; background-color: rgba(255,255,255,0.025); border-width: 1px; border-color: rgba(90,202,211,0.18); }
.gov-science-top { flex-direction: row; align-items: flex-start; margin-bottom: 8px; }
.gov-science-index { width: 30px; min-height: 30px; margin-right: 10px; padding-top: 6px; -unity-text-align: middle-center; color: rgb(54,214,220); background-color: rgba(54,214,220,0.09); border-width: 1px; border-color: rgba(54,214,220,0.35); }
.gov-science-subtitle { margin-top: 4px; color: rgb(159,176,189); font-size: 12px; white-space: normal; }
.gov-science-body { margin-bottom: 10px; color: rgb(220,231,238); font-size: 12px; white-space: normal; }
.gov-science-status { margin-bottom: 8px; font-size: 11px; -unity-font-style: bold; letter-spacing: 0.6px; }
.state-good { color: rgb(110,211,111); }
.state-warn { color: rgb(240,166,60); }
.state-bad { color: rgb(255,91,91); }
.state-info { color: rgb(54,214,220); }

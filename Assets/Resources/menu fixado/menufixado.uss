/* StyleSheet for Colony Status Bar UI */

.colony-status-container {
    width: 110%;
    align-items: center;
    justify-content: flex-start;
    padding-top: 0;
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    position: absolute;
    top: -1%;
    left: -5%;
}

.status-bar-panel {
    width: 100%;
    max-width: 1760px;
    height: 58px;
    background-color: rgba(7, 24, 39, 0.72); /* Cor anterior azul escuro */
    border-width: 1.5px;
    border-color: rgba(0, 195, 255, 0.4); /* Borda azul anterior */
    border-radius: 8px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 20px;
    padding-right: 20px;
    
    /* Glow effect anterior */
    border-left-color: rgba(0, 195, 255, 0.55);
    border-right-color: rgba(0, 195, 255, 0.55);
    border-top-color: rgba(0, 195, 255, 0.55);
    border-bottom-color: rgba(0, 195, 255, 0.55);
}

.status-title-group {
    flex-direction: row;
    align-items: center;
}

.status-title {
    color: rgb(160, 220, 245); /* Cor azul claro anterior */
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-right: 12px;
}

.resources-group {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    justify-content: space-between;
    flex-wrap: nowrap;
}

.resource-item {
    flex-direction: row;
    align-items: center;
    margin-left: 3px;
    margin-right: 3px;
}

.country-item {
    background-color: rgba(0, 195, 255, 0.15);
    padding: 3px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(0, 195, 255, 0.3);
}

.country-text {
    color: #e2e8f0;
    font-size: 11px;
    -unity-font-style: bold;
}

/* Emoji Icons */
.resource-emoji {
    font-size: 16px;
    margin-right: 4px;
    -unity-text-align: middle-center;
}

/* Value Labels */
.resource-base-value {
    color: rgb(240, 248, 255); /* Azul/branco anterior */
    font-size: 11px;
    -unity-font-style: bold;
}

.resource-bonus {
    color: #22c55e;
    font-size: 9px;
    margin-left: 2px;
    -unity-font-style: bold;
}

.resource-bonus-value {
    color: #22c55e;
    font-size: 9px;
    margin-left: 2px;
    -unity-font-style: bold;
}

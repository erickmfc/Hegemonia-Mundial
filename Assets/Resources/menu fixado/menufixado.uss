/* StyleSheet for Colony Status Bar UI */

.colony-status-container {
    width: 110%;
    align-items: center;
    justify-content: flex-start;
    padding-top: 0;
    position: absolute;
    top: -1%;
    left: -5%;
}

.status-bar-panel {
    width: 100%;
    max-width: 1760px;
    height: 58px;
    background-color: rgba(7, 24, 39, 0.72); /* Cor anterior azul escuro */
    border-width: 1.5px;
    border-color: rgba(0, 195, 255, 0.4); /* Borda azul anterior */
    border-radius: 8px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 20px;
    padding-right: 20px;
    
    /* Glow effect anterior */
    border-left-color: rgba(0, 195, 255, 0.55);
    border-right-color: rgba(0, 195, 255, 0.55);
    border-top-color: rgba(0, 195, 255, 0.55);
    border-bottom-color: rgba(0, 195, 255, 0.55);
}

.status-title-group {
    flex-direction: row;
    align-items: center;
}

.status-title {
    color: rgb(160, 220, 245); /* Cor azul claro anterior */
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-right: 12px;
}

.status-title-button {
    color: rgb(160, 220, 245);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding-left: 0;
    padding-right: 12px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-right: 8px;
    min-width: 72px;
    -unity-font-style: bold;
    font-size: 14px;
    letter-spacing: 1.5px;
    -unity-text-align: middle-left;
}

.status-title-button:hover,
.status-title-button:focus,
.status-title-button:active {
    color: rgb(235, 250, 255);
    background-color: rgba(0, 195, 255, 0.16);
    border-width: 0;
}

.status-title-button.has-news {
    color: rgb(245, 253, 255);
    background-color: rgba(0, 195, 255, 0.22);
    border-width: 1px;
    border-color: rgba(0, 214, 255, 0.85);
    border-radius: 5px;
}

.status-title-button.has-news.status-pulse {
    color: rgb(255, 255, 255);
    background-color: rgba(0, 195, 255, 0.68);
    border-color: rgb(135, 235, 255);
}

.resources-group {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    justify-content: space-between;
    flex-wrap: nowrap;
}

.resource-item {
    flex-direction: row;
    align-items: center;
    margin-left: 3px;
    margin-right: 3px;
}

.country-item {
    background-color: rgba(0, 195, 255, 0.15);
    padding: 3px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(0, 195, 255, 0.3);
}

.country-text {
    color: #e2e8f0;
    font-size: 11px;
    -unity-font-style: bold;
}

/* Emoji Icons */
.resource-emoji {
    font-size: 16px;
    margin-right: 4px;
    -unity-text-align: middle-center;
}

/* Value Labels */
.resource-base-value {
    color: rgb(240, 248, 255); /* Azul/branco anterior */
    font-size: 11px;
    -unity-font-style: bold;
}

.resource-bonus {
    color: #22c55e;
    font-size: 9px;
    margin-left: 2px;
    -unity-font-style: bold;
}

.resource-bonus-value {
    color: #22c55e;
    font-size: 9px;
    margin-left: 2px;
    -unity-font-style: bold;
}

/* Painel de notificacoes */
.decision-banner {
    position: absolute;
    top: 62px;
    left: 72px;
    width: 510px;
    min-height: 58px;
    max-width: 62%;
    padding-left: 12px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(70, 28, 18, 0.96);
    border-left-width: 4px;
    border-left-color: rgb(255, 177, 85);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(255, 213, 149, 0.42);
    border-right-color: rgba(255, 213, 149, 0.24);
    border-bottom-color: rgba(255, 213, 149, 0.24);
    border-radius: 6px;
}

.decision-banner.is-hidden {
    display: none;
}

.decision-copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
}

.decision-title {
    color: rgb(255, 239, 194);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

.decision-message {
    margin-top: 3px;
    color: rgb(255, 225, 186);
    font-size: 11px;
    white-space: normal;
}

.decision-action {
    min-width: 116px;
    min-height: 32px;
    margin-left: 10px;
    color: rgb(255, 248, 224);
    background-color: rgba(230, 112, 46, 0.82);
    border-width: 1px;
    border-color: rgba(255, 220, 164, 0.75);
    border-radius: 5px;
    -unity-font-style: bold;
    font-size: 11px;
}

.decision-action:hover,
.decision-action:focus {
    background-color: rgba(255, 151, 68, 0.96);
    color: white;
}

.decision-close {
    width: 26px;
    height: 26px;
    min-width: 26px;
    margin-left: 6px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgba(255, 239, 194, 0.82);
    background-color: rgba(0, 0, 0, 0.18);
    border-width: 0;
    border-radius: 13px;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.decision-close:hover,
.decision-close:focus {
    color: white;
    background-color: rgba(255, 151, 68, 0.72);
}

.notification-panel {
    position: absolute;
    top: 66px;
    left: 72px;
    width: 448px;
    height: 432px;
    padding: 12px;
    background-color: rgba(23, 46, 64, 0.96);
    border-width: 1px;
    border-color: rgba(125, 196, 224, 0.5);
    border-radius: 11px;
    flex-direction: column;
    overflow: hidden;
    -unity-font-style: normal;
}

.notification-panel.is-hidden,
.notification-help.is-hidden {
    display: none;
}

.notification-header {
    height: 38px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 4px;
}

.notification-heading {
    flex-direction: row;
    align-items: center;
}

.notification-bell {
    width: 25px;
    height: 25px;
    margin-right: 8px;
    color: rgb(241, 247, 252);
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 13px;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.notification-title {
    color: rgb(241, 247, 252);
    font-size: 16px;
    letter-spacing: 0.7px;
    -unity-font-style: bold;
}

.notification-close {
    width: 28px;
    height: 28px;
    min-width: 28px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgba(225, 239, 248, 0.82);
    background-color: rgba(0, 0, 0, 0.16);
    border-width: 0;
    border-radius: 14px;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.notification-close:hover,
.notification-close:focus {
    color: white;
    background-color: rgba(0, 195, 255, 0.34);
}

.notification-tabs {
    height: 42px;
    flex-shrink: 0;
    margin-top: 4px;
    margin-bottom: 10px;
    padding: 4px;
    flex-direction: row;
    background-color: rgba(8, 25, 40, 0.44);
    border-radius: 7px;
}

.notification-tab {
    flex-grow: 1;
    height: 34px;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 8px;
    padding-right: 8px;
    color: rgba(229, 242, 249, 0.78);
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 0;
    border-radius: 5px;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.notification-tab:hover,
.notification-tab:focus {
    color: white;
    background-color: rgba(0, 195, 255, 0.18);
}

.notification-tab.is-active {
    color: rgb(232, 249, 255);
    background-color: rgba(0, 137, 201, 0.58);
    border-width: 1px;
    border-color: rgba(46, 195, 255, 0.9);
    -unity-font-style: bold;
}

.notification-list {
    flex-grow: 1;
    min-height: 0;
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 7px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 5px;
    padding-bottom: 5px;
}

.notification-list .unity-scroll-view__content-container {
    padding-right: 0;
}

.notification-item {
    min-height: 68px;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 4px;
    padding-right: 4px;
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: rgba(94, 116, 132, 0.16);
}

.notification-severity {
    width: 27px;
    height: 27px;
    margin-top: 2px;
    margin-right: 9px;
    border-radius: 14px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.notification-severity.warning {
    color: rgb(126, 75, 0);
    background-color: rgb(255, 218, 117);
}

.notification-severity.info {
    color: rgb(0, 89, 130);
    background-color: rgb(185, 231, 249);
}

.notification-severity.success {
    color: rgb(20, 106, 65);
    background-color: rgb(180, 239, 202);
}

.notification-severity.critical {
    color: rgb(137, 34, 34);
    background-color: rgb(255, 190, 190);
}

.notification-item-copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
}

.notification-item-title {
    color: rgb(40, 60, 72);
    font-size: 12px;
    white-space: normal;
    flex-shrink: 1;
    -unity-font-style: bold;
}

.notification-item-message {
    margin-top: 3px;
    color: rgb(72, 88, 99);
    font-size: 11px;
    white-space: normal;
    -unity-font-style: normal;
}

.notification-item-time {
    margin-left: 8px;
    width: 34px;
    min-width: 34px;
    flex-shrink: 0;
    color: rgb(117, 135, 145);
    font-size: 9px;
    -unity-text-align: upper-right;
}

.notification-action {
    min-width: 92px;
    min-height: 26px;
    margin-left: 8px;
    align-self: center;
    color: rgb(0, 80, 118);
    background-color: rgba(192, 232, 249, 0.92);
    border-width: 1px;
    border-color: rgba(0, 120, 172, 0.38);
    border-radius: 4px;
    font-size: 10px;
    -unity-font-style: bold;
}

.notification-action:hover,
.notification-action:focus {
    color: rgb(0, 48, 75);
    background-color: rgb(220, 246, 255);
}

.notification-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    color: rgb(105, 123, 133);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.notification-help {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    padding: 22px 18px;
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 7px;
}

.help-title {
    color: rgb(40, 60, 72);
    font-size: 14px;
    white-space: normal;
    flex-shrink: 1;
    -unity-font-style: bold;
}

.help-copy,
.help-tip {
    margin-top: 12px;
    color: rgb(72, 88, 99);
    font-size: 11px;
    white-space: normal;
}

.help-tip {
    color: rgb(0, 128, 184);
    -unity-font-style: bold;
}

@media (max-width: 720px) {
    .decision-banner {
        left: 8px;
        width: 390px;
        max-width: 92%;
    }

    .notification-panel {
        left: 8px;
        width: 390px;
        max-width: 92%;
    }
}

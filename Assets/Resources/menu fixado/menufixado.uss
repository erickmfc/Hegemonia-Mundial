/* Barra superior naval: acabamento metalico azul, mantendo os campos dinamicos. */
.colony-status-container {
    width: 100%;
    align-items: center;
    justify-content: flex-start;
    padding-top: 0;
    position: absolute;
    top: 0;
    left: 0;
}

.status-bar-panel {
    width: 100%;
    max-width: none;
    height: 78px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 12px;
    padding-right: 12px;
}

.status-panel-art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Resources/HUDSuperiorNaval/painel_naval.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.status-panel-mask {
    position: absolute;
    left: 118px;
    right: 124px;
    top: 11px;
    bottom: 11px;
    background-color: rgba(3, 17, 27, 1);
}
.status-title-group {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-width: 178px;
    height: 100%;
    border-right-width: 1px;
    border-right-color: rgba(193, 162, 98, 0.9);
    margin-right: 4px;
}

.status-title-button {
    color: rgb(255, 241, 204);
    background-color: rgba(91, 67, 28, 0.96);
    border-width: 1px;
    border-color: rgba(218, 182, 103, 0.82);
    border-radius: 3px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-right: 7px;
    min-width: 64px;
    -unity-font-style: bold;
    font-size: 13px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.status-title-button:hover,
.status-title-button:focus,
.status-title-button:active {
    color: white;
    background-color: rgba(39, 106, 134, 0.96);
    border-color: rgb(164, 220, 235);
}

.status-title-button.has-news {
    color: rgb(255, 239, 193);
    background-color: rgba(112, 78, 25, 0.94);
    border-width: 1px;
    border-color: rgb(226, 179, 78);
    border-radius: 3px;
}

.status-title-button.has-news.status-pulse {
    color: white;
    background-color: rgba(161, 111, 31, 0.98);
    border-color: rgb(255, 224, 139);
}

.resources-group {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    justify-content: space-between;
    flex-wrap: nowrap;
    overflow: hidden;
    padding-right: 124px;
}

.resource-item {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
    min-height: 42px;
    margin-left: 0;
    margin-right: 0;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgba(3, 17, 27, 0);
    border-width: 0;
    border-right-width: 1px;
    border-right-color: rgba(164, 184, 188, 0.52);
    border-radius: 0;
}

.country-item {
    min-height: 32px;
    padding-left: 5px;
    padding-right: 7px;
    background-color: rgba(16, 49, 65, 0);
    border-width: 0;
}

.country-text {
    color: rgb(238, 245, 239);
    font-size: 10px;
    -unity-font-style: bold;
}

/* Icones importados dos recursos HUD naval. */
.resource-emoji {
    width: 21px;
    height: 21px;
    margin-right: 4px;
    flex-shrink: 0;
    font-size: 0;
    color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.country-item .resource-emoji {
    width: 18px;
    height: 18px;
    background-image: url("project://database/Assets/Resources/HUDSuperiorNaval/16_radar_mapa.png");
}

.resource-money { border-color: rgba(208, 168, 79, 0.85); }
.resource-energy { border-color: rgba(208, 168, 79, 0.72); }
.resource-military { border-color: rgba(208, 168, 79, 0.72); }

.resource-date .resource-emoji { background-image: url("project://database/Assets/Resources/HUDSuperiorNaval/01_calendario.png"); }
.resource-money .resource-emoji { background-image: url("project://database/Assets/Resources/HUDSuperiorNaval/02_dinheiro.png"); }
.resource-currency .resource-emoji,
.resource-gold .resource-emoji { background-image: url("project://database/Assets/Resources/HUDSuperiorNaval/03_economia.png"); }
.resource-storage .resource-emoji { background-image: url("project://database/Assets/Resources/HUDSuperiorNaval/04_armazem.png"); }
.resource-happy .resource-emoji { background-image: url("project://database/Assets/Resources/HUDSuperiorNaval/05_estabilidade.png"); }
.resource-pop .resource-emoji { background-image: url("project://database/Assets/Resources/HUDSuperiorNaval/06_populacao.png"); }
.resource-dead .resource-emoji { background-image: url("project://database/Assets/Resources/HUDSuperiorNaval/15_reservistas.png"); }
.resource-jobs .resource-emoji { background-image: url("project://database/Assets/Resources/HUDSuperiorNaval/13_industria.png"); }
.resource-oil .resource-emoji { background-image: url("project://database/Assets/Resources/HUDSuperiorNaval/10_petroleo.png"); }
.resource-steel .resource-emoji { background-image: url("project://database/Assets/Resources/HUDSuperiorNaval/08_aco.png"); }
.resource-food .resource-emoji { background-image: url("project://database/Assets/Resources/HUDSuperiorNaval/09_comida.png"); }
.resource-energy .resource-emoji { background-image: url("project://database/Assets/Resources/HUDSuperiorNaval/11_energia.png"); }
.resource-military .resource-emoji { background-image: url("project://database/Assets/Resources/HUDSuperiorNaval/14_militares.png"); }

.resource-base-value {
    color: rgb(244, 247, 245);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
}

.resource-bonus {
    color: rgb(107, 224, 139);
    font-size: 9px;
    margin-left: 2px;
    -unity-font-style: bold;
}

.resource-bonus-value {
    color: rgb(107, 224, 139);
    font-size: 9px;
    margin-left: 2px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
}

.resource-optional,
.resource-narrow,
.resource-bonus-value,
.resource-bonus {
    display: none;
}

.hud-wide .resource-optional,
.hud-wide .resource-narrow,
.hud-wide .resource-bonus-value,
.hud-wide .resource-bonus {
    display: flex;
}

.hud-compact .resource-optional,
.hud-compact .resource-narrow,
.hud-compact .resource-bonus-value,
.hud-compact .resource-bonus {
    display: none;
}

.status-title-group { min-width: 170px; }
.hud-compact .status-title-button { min-width: 58px; font-size: 12px; letter-spacing: 1px; }
.hud-compact .country-text { font-size: 9px; }
.hud-compact .resource-base-value { font-size: 10px; }
.hud-compact .resource-item { padding-left: 3px; padding-right: 3px; }

.hud-very-compact .resource-gold,
.hud-very-compact .resource-happy,
.hud-very-compact .resource-storage { display: none; }
.status-title-group { min-width: 150px; }
/* Painel de notificacoes */
.decision-banner {
    position: absolute;
    top: 62px;
    left: 72px;
    width: 510px;
    min-height: 58px;
    max-width: 62%;
    padding-left: 12px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(70, 28, 18, 0.96);
    border-left-width: 4px;
    border-left-color: rgb(255, 177, 85);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(255, 213, 149, 0.42);
    border-right-color: rgba(255, 213, 149, 0.24);
    border-bottom-color: rgba(255, 213, 149, 0.24);
    border-radius: 6px;
}

.decision-banner.is-hidden {
    display: none;
}

.decision-copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
}

.decision-title {
    color: rgb(255, 239, 194);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

.decision-message {
    margin-top: 3px;
    color: rgb(255, 225, 186);
    font-size: 11px;
    white-space: normal;
}

.decision-action {
    min-width: 116px;
    min-height: 32px;
    margin-left: 10px;
    color: rgb(255, 248, 224);
    background-color: rgba(230, 112, 46, 0.82);
    border-width: 1px;
    border-color: rgba(255, 220, 164, 0.75);
    border-radius: 3px;
    -unity-font-style: bold;
    font-size: 11px;
}

.decision-action:hover,
.decision-action:focus {
    background-color: rgba(255, 151, 68, 0.96);
    color: white;
}

.decision-close {
    width: 26px;
    height: 26px;
    min-width: 26px;
    margin-left: 6px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgba(255, 239, 194, 0.82);
    background-color: rgba(0, 0, 0, 0.18);
    border-width: 0;
    border-radius: 13px;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.decision-close:hover,
.decision-close:focus {
    color: white;
    background-color: rgba(255, 151, 68, 0.72);
}

.tutorial-banner {
    position: absolute;
    bottom: 96px;
    left: 50%;
    margin-left: -310px;
    width: 620px;
    max-width: 78%;
    min-height: 54px;
    padding-left: 16px;
    padding-right: 8px;
    padding-top: 9px;
    padding-bottom: 9px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(13, 42, 61, 0.96);
    border-left-width: 4px;
    border-left-color: rgb(73, 201, 255);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(125, 219, 255, 0.55);
    border-right-color: rgba(125, 219, 255, 0.28);
    border-bottom-color: rgba(125, 219, 255, 0.28);
    border-radius: 7px;
}

.tutorial-banner.is-hidden {
    display: none;
}

.tutorial-copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
}

.tutorial-title {
    color: rgb(180, 237, 255);
    font-size: 12px;
    -unity-font-style: bold;
}

.tutorial-message {
    margin-top: 3px;
    color: rgb(238, 250, 255);
    font-size: 12px;
    white-space: normal;
}

.tutorial-close {
    width: 27px;
    height: 27px;
    min-width: 27px;
    margin-left: 8px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgba(218, 246, 255, 0.82);
    background-color: rgba(0, 0, 0, 0.18);
    border-width: 0;
    border-radius: 14px;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.tutorial-close:hover,
.tutorial-close:focus {
    color: white;
    background-color: rgba(0, 195, 255, 0.42);
}

.quick-actions {
    position: absolute;
    bottom: 18px;
    left: 50%;
    margin-left: -360px;
    width: 720px;
    max-width: 92%;
    min-height: 62px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 6px;
    padding-bottom: 6px;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    background-color: rgba(6, 22, 35, 0.9);
    border-width: 1px;
    border-color: rgba(91, 191, 232, 0.48);
    border-radius: 8px;
}

.quick-action {
    flex-grow: 1;
    min-width: 82px;
    margin-left: 3px;
    margin-right: 3px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 4px;
    padding-bottom: 4px;
    color: rgb(221, 242, 250);
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 1px;
    border-color: rgba(136, 207, 238, 0.26);
    border-radius: 3px;
    -unity-font-style: bold;
    font-size: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.quick-action:hover,
.quick-action:focus {
    color: white;
    background-color: rgba(0, 159, 214, 0.52);
    border-color: rgba(104, 223, 255, 0.9);
}

.quick-action-primary {
    min-width: 116px;
    color: rgb(255, 242, 204);
    background-color: rgba(171, 97, 27, 0.74);
    border-color: rgba(255, 196, 107, 0.76);
}

.quick-action-primary:hover,
.quick-action-primary:focus {
    background-color: rgba(224, 132, 39, 0.92);
    border-color: rgb(255, 224, 154);
}

.quick-actions-close {
    flex-grow: 0;
    min-width: 38px;
    width: 38px;
    margin-left: 5px;
    color: rgb(255, 220, 220);
    background-color: rgba(145, 35, 42, 0.88);
    border-color: rgba(255, 145, 150, 0.78);
    border-radius: 3px;
    -unity-font-style: bold;
    font-size: 14px;
    -unity-text-align: middle-center;
}

.quick-actions-close:hover,
.quick-actions-close:focus {
    color: white;
    background-color: rgba(205, 45, 55, 0.98);
    border-color: rgb(255, 190, 190);
}

.quick-actions.is-hidden {
    display: none;
}

.notification-panel {
    position: absolute;
    top: 66px;
    left: 72px;
    width: 448px;
    height: 432px;
    padding: 12px;
    background-color: rgba(23, 46, 64, 0.96);
    border-width: 1px;
    border-color: rgba(125, 196, 224, 0.5);
    border-radius: 11px;
    flex-direction: column;
    overflow: hidden;
    -unity-font-style: normal;
}

.notification-panel.is-hidden,
.notification-help.is-hidden {
    display: none;
}

.notification-header {
    height: 38px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 4px;
}

.notification-heading {
    flex-direction: row;
    align-items: center;
}

.notification-bell {
    width: 25px;
    height: 25px;
    margin-right: 8px;
    color: rgb(241, 247, 252);
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 13px;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.notification-title {
    color: rgb(241, 247, 252);
    font-size: 16px;
    letter-spacing: 0.7px;
    -unity-font-style: bold;
}

.notification-close {
    width: 28px;
    height: 28px;
    min-width: 28px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgba(225, 239, 248, 0.82);
    background-color: rgba(0, 0, 0, 0.16);
    border-width: 0;
    border-radius: 14px;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.notification-close:hover,
.notification-close:focus {
    color: white;
    background-color: rgba(0, 195, 255, 0.34);
}

.notification-tabs {
    height: 42px;
    flex-shrink: 0;
    margin-top: 4px;
    margin-bottom: 10px;
    padding: 4px;
    flex-direction: row;
    background-color: rgba(8, 25, 40, 0.44);
    border-radius: 7px;
}

.notification-tab {
    flex-grow: 1;
    height: 34px;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 8px;
    padding-right: 8px;
    color: rgba(229, 242, 249, 0.78);
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 0;
    border-radius: 3px;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.notification-tab:hover,
.notification-tab:focus {
    color: white;
    background-color: rgba(0, 195, 255, 0.18);
}

.notification-tab.is-active {
    color: rgb(232, 249, 255);
    background-color: rgba(0, 137, 201, 0.58);
    border-width: 1px;
    border-color: rgba(46, 195, 255, 0.9);
    -unity-font-style: bold;
}

.notification-list {
    flex-grow: 1;
    min-height: 0;
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 7px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 5px;
    padding-bottom: 5px;
}

.notification-list .unity-scroll-view__content-container {
    padding-right: 0;
}

.notification-item {
    min-height: 68px;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 4px;
    padding-right: 4px;
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: rgba(94, 116, 132, 0.16);
}

.notification-item-info {
    background-color: rgba(198, 235, 248, 0.34);
}

.notification-item-warning {
    background-color: rgba(255, 232, 166, 0.42);
}

.notification-item-success {
    background-color: rgba(188, 241, 207, 0.42);
}

.notification-item-critical {
    background-color: rgba(255, 199, 199, 0.46);
}

.notification-severity {
    width: 27px;
    height: 27px;
    margin-top: 2px;
    margin-right: 9px;
    border-radius: 14px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.notification-severity.warning {
    color: rgb(126, 75, 0);
    background-color: rgb(255, 218, 117);
}

.notification-severity.info {
    color: rgb(0, 89, 130);
    background-color: rgb(185, 231, 249);
}

.notification-severity.success {
    color: rgb(20, 106, 65);
    background-color: rgb(180, 239, 202);
}

.notification-severity.critical {
    color: rgb(137, 34, 34);
    background-color: rgb(255, 190, 190);
}

.notification-item-copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
}

.notification-item-title {
    color: rgb(40, 60, 72);
    font-size: 12px;
    white-space: normal;
    flex-shrink: 1;
    -unity-font-style: bold;
}

.notification-item-message {
    margin-top: 3px;
    color: rgb(72, 88, 99);
    font-size: 11px;
    white-space: normal;
    -unity-font-style: normal;
}

.notification-item-time {
    margin-left: 8px;
    width: 34px;
    min-width: 34px;
    flex-shrink: 0;
    color: rgb(117, 135, 145);
    font-size: 9px;
    -unity-text-align: upper-right;
}

.notification-dismiss {
    width: 24px;
    height: 24px;
    min-width: 24px;
    margin-left: 5px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgba(40, 60, 72, 0.72);
    background-color: rgba(255, 255, 255, 0.32);
    border-width: 0;
    border-radius: 12px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.notification-dismiss:hover,
.notification-dismiss:focus {
    color: rgb(20, 45, 60);
    background-color: rgba(255, 255, 255, 0.8);
}

.notification-action {
    min-width: 92px;
    min-height: 26px;
    margin-left: 8px;
    align-self: center;
    color: rgb(0, 80, 118);
    background-color: rgba(192, 232, 249, 0.92);
    border-width: 1px;
    border-color: rgba(0, 120, 172, 0.38);
    border-radius: 4px;
    font-size: 10px;
    -unity-font-style: bold;
}

.notification-action:hover,
.notification-action:focus {
    color: rgb(0, 48, 75);
    background-color: rgb(220, 246, 255);
}

.notification-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    color: rgb(105, 123, 133);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.notification-help {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    padding: 22px 18px;
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 7px;
}

.help-title {
    color: rgb(40, 60, 72);
    font-size: 14px;
    white-space: normal;
    flex-shrink: 1;
    -unity-font-style: bold;
}

.help-copy,
.help-tip {
    margin-top: 12px;
    color: rgb(72, 88, 99);
    font-size: 11px;
    white-space: normal;
}

.help-tip {
    color: rgb(0, 128, 184);
    -unity-font-style: bold;
}

@media (max-width: 720px) {
    .decision-banner {
        left: 8px;
        width: 390px;
        max-width: 92%;
    }

    .notification-panel {
        left: 8px;
        width: 390px;
        max-width: 92%;
    }

    .tutorial-banner {
        bottom: 94px;
        left: 8px;
        margin-left: 0;
        width: 390px;
        max-width: 92%;
    }

    .quick-actions {
        left: 8px;
        margin-left: 0;
        width: 390px;
        max-width: 92%;
    }

    .quick-action {
        min-width: 52px;
        font-size: 8px;
    }

    .quick-action-primary {
        min-width: 76px;
    }
}






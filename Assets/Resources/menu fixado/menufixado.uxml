<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd"
>
    <!-- Link the USS stylesheet -->
    <ui:Style src="menufixado.uss" />

    <!-- Top Status Bar Panel -->
    <ui:VisualElement name="status-container" class="colony-status-container">
        <ui:VisualElement name="status-bar-panel" class="status-bar-panel">
            
            <!-- Left Side: Title & Country -->
            <ui:VisualElement name="status-title-group" class="status-title-group">
                <ui:Button name="status-toggle" text="STATUS" class="status-title-button" />
                <ui:VisualElement class="resource-item country-item">
                    <ui:Label text="🌍" class="resource-emoji" />
                    <ui:Label text="REPÚBLICA" name="lbl-country-val" class="resource-base-value country-text" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Right Side: Resource Indicators -->
            <ui:VisualElement class="resources-group">
                
                <!-- Data (Date) -->
                <ui:VisualElement class="resource-item resource-date">
                    <ui:Label text="📅" class="resource-emoji" />
                    <ui:Label text="01/01/2000" name="lbl-date-val" class="resource-base-value" />
                </ui:VisualElement>

                <!-- Dinheiro (Money) -->
                <ui:VisualElement class="resource-item resource-money">
                    <ui:Label text="💵" class="resource-emoji" />
                    <ui:Label text="0" name="lbl-money-val" class="resource-base-value" />
                    <ui:Label text="+0/s" name="lbl-money-bonus" class="resource-bonus-value" />
                </ui:VisualElement>

                <!-- Moeda (Currency) -->
                <ui:VisualElement class="resource-item resource-currency">
                    <ui:Label text="🪙" class="resource-emoji" />
                    <ui:Label text="0" name="lbl-currency-val" class="resource-base-value" />
                </ui:VisualElement>

                <!-- Ouro (Gold) -->
                <ui:VisualElement class="resource-item resource-gold resource-narrow">
                    <ui:Label text="💰" class="resource-emoji" />
                    <ui:Label text="0" name="lbl-gold-val" class="resource-base-value" />
                </ui:VisualElement>

                <!-- Felicidade (Happiness) -->
                <ui:VisualElement class="resource-item resource-happy resource-narrow">
                    <ui:Label text="😃" class="resource-emoji" />
                    <ui:Label text="100%" name="lbl-happy-val" class="resource-base-value" />
                </ui:VisualElement>

                <!-- População Civil -->
                <ui:VisualElement class="resource-item resource-pop">
                    <ui:Label text="👥" class="resource-emoji" />
                    <ui:Label text="0/0" name="lbl-pop-val" class="resource-base-value" />
                </ui:VisualElement>

                <ui:VisualElement class="resource-item resource-dead resource-optional">
                    <ui:Label text="☠" class="resource-emoji" />
                    <ui:Label text="0" name="lbl-dead-val" class="resource-base-value" />
                </ui:VisualElement>

                <!-- Empregos (Jobs) -->
                <ui:VisualElement class="resource-item resource-jobs resource-optional">
                    <ui:Label text="💼" class="resource-emoji" />
                    <ui:Label text="0" name="lbl-jobs-val" class="resource-base-value" />
                </ui:VisualElement>

                <!-- Petróleo (Oil) -->
                <ui:VisualElement class="resource-item resource-oil">
                    <ui:Label text="🛢️" class="resource-emoji" />
                    <ui:Label text="0" name="lbl-oil-val" class="resource-base-value" />
                    <ui:Label text="+0/s" name="lbl-oil-bonus" class="resource-bonus-value" />
                </ui:VisualElement>

                <!-- Aço (Steel) -->
                <ui:VisualElement class="resource-item resource-steel">
                    <ui:Label text="🔩" class="resource-emoji" />
                    <ui:Label text="0" name="lbl-steel-val" class="resource-base-value" />
                    <ui:Label text="+0/s" name="lbl-steel-bonus" class="resource-bonus-value" />
                </ui:VisualElement>

                <!-- Comida (Food) -->
                <ui:VisualElement class="resource-item resource-food resource-optional">
                    <ui:Label text="🌾" class="resource-emoji" />
                    <ui:Label text="0" name="lbl-food-val" class="resource-base-value" />
                    <ui:Label text="+0/s" name="lbl-food-bonus" class="resource-bonus" />
                </ui:VisualElement>

                <!-- Energia (Energy) -->
                <ui:VisualElement class="resource-item resource-energy">
                    <ui:Label text="⚡" class="resource-emoji" />
                    <ui:Label text="0/0 MW" name="lbl-energy-val" class="resource-base-value" />
                    <ui:Label text="SEM REDE" name="lbl-energy-bonus" class="resource-bonus-value" />
                </ui:VisualElement>

                <!-- Armazém (Storage) -->
                <ui:VisualElement class="resource-item resource-storage resource-narrow">
                    <ui:Label text="📦" class="resource-emoji" />
                    <ui:Label text="0%" name="lbl-storage-val" class="resource-base-value" />
                </ui:VisualElement>

                <!-- Militares (Military) -->
                <ui:VisualElement class="resource-item resource-military">
                    <ui:Label text="🪖" class="resource-emoji" />
                    <ui:Label text="0" name="lbl-military-val" class="resource-base-value" />
                    <ui:Label text="+0" name="lbl-military-bonus" class="resource-bonus-value" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

    <!-- Decisao prioritaria: causa atual e proximo passo sem abrir menus. -->
    <ui:VisualElement name="decision-banner" class="decision-banner is-hidden">
        <ui:VisualElement class="decision-copy">
            <ui:Label name="decision-title" class="decision-title" />
            <ui:Label name="decision-message" class="decision-message" />
        </ui:VisualElement>
        <ui:Button name="decision-action" class="decision-action" />
        <ui:Button name="decision-close" text="×" class="decision-close" tooltip="Fechar alerta" />
    </ui:VisualElement>

    <ui:VisualElement name="tutorial-banner" class="tutorial-banner is-hidden">
        <ui:VisualElement class="tutorial-copy">
            <ui:Label name="tutorial-title" text="GUIA RAPIDO" class="tutorial-title" />
            <ui:Label name="tutorial-message" class="tutorial-message" />
        </ui:VisualElement>
        <ui:Button name="tutorial-close" text="Ã—" class="tutorial-close" tooltip="Fechar tutorial" />
    </ui:VisualElement>

    <!-- Acesso rapido sempre visivel. A Prefeitura vem primeiro porque e a fundacao da partida. -->
    <ui:VisualElement name="quick-actions" class="quick-actions">
        <ui:Button name="quick-city-hall" text="PREFEITURA" class="quick-action quick-action-primary" tooltip="Abrir Prefeitura (Construcao)" />
        <ui:Button name="quick-government" text="X  GOVERNO" class="quick-action" tooltip="Abrir Governo (X)" />
        <ui:Button name="quick-construction" text="C  CONSTRUCAO" class="quick-action" tooltip="Abrir Construcao (C)" />
        <ui:Button name="quick-pier" text="V  PIER" class="quick-action" tooltip="Abrir Pier (V)" />
        <ui:Button name="quick-barracks" text="B  QUARTEL" class="quick-action" tooltip="Abrir Quartel (B)" />
        <ui:Button name="quick-airport" text="Z  AEROPORTO" class="quick-action" tooltip="Abrir Aeroporto (Z)" />
        <ui:Button name="quick-actions-close" text="X" class="quick-actions-close" tooltip="Fechar painel atual" />
    </ui:VisualElement>

    <!-- Central de acontecimentos: abre pelo botao STATUS e pode ser fechada no X. -->
        <ui:VisualElement name="notification-panel" class="notification-panel is-hidden">
            <ui:VisualElement class="notification-header">
                <ui:VisualElement class="notification-heading">
                    <ui:Label text="!" class="notification-bell" />
                    <ui:Label text="NOTIFICACOES" class="notification-title" />
                </ui:VisualElement>
                <ui:Button name="notification-close" text="×" class="notification-close" />
            </ui:VisualElement>

            <ui:VisualElement class="notification-tabs">
                <ui:Button name="tab-today" text="Hoje" class="notification-tab is-active" />
                <ui:Button name="tab-events" text="Eventos" class="notification-tab" />
                <ui:Button name="tab-help" text="Ajuda" class="notification-tab" />
            </ui:VisualElement>

            <ui:ScrollView name="notification-list" class="notification-list" mode="Vertical" />

            <ui:VisualElement name="notification-help" class="notification-help is-hidden">
                <ui:Label text="Este painel reúne os acontecimentos importantes do país." class="help-title" />
                <ui:Label text="Aqui aparecem necessidades do governo, alertas de recursos e notícias de outras nações. O feed é atualizado quando algo relevante acontece." class="help-copy" />
                <ui:Label text="Clique em STATUS ou no X para fechar." class="help-tip" />
            </ui:VisualElement>
        </ui:VisualElement>
</ui:UXML>

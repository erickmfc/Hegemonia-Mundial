<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
    xsi="http://www.w3.org/2001/XMLSchema-instance"
    engine="UnityEngine.UIElements"
    noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
    editor-extension-mode="False">

    <Style src="project://database/Assets/Resources/MenuComando/MenuComando.uss" />

    <ui:VisualElement name="menu-command-host" class="menu-command-host" picking-mode="Ignore">

    <ui:VisualElement name="menu-comando-root" class="menu-root" picking-mode="Ignore">

        <!-- OVERLAY CRT scanlines -->
        <ui:VisualElement name="crt-overlay" class="crt-overlay" picking-mode="Ignore" />

        <!-- HEADER -->
        <ui:VisualElement name="header" class="header">
            <ui:Label name="header-titulo" text="🎯 COMANDO TÁTICO" class="header-titulo mono" />
            <ui:VisualElement name="header-center" class="header-center">
                <ui:Label name="header-status" text="● SISTEMA OPERACIONAL" class="header-status blink" />
            </ui:VisualElement>
            <ui:Label name="header-tempo-op" text="T.OP: 00:00:00" class="header-tempo mono" />
            <ui:Button name="btn-fechar-menu" text="FECHAR 1" class="menu-fechar mono" />
        </ui:VisualElement>

        <!-- CORPO PRINCIPAL: Mapa | FLIR -->
        <ui:VisualElement name="corpo-principal" class="corpo-principal" picking-mode="Ignore">

            <!-- PAINEL ESQUERDO: MAPA TÁTICO -->
            <ui:VisualElement name="painel-mapa" class="rts-panel painel-mapa">
                <ui:Label name="mapa-titulo" text="◉ MAPA TÁTICO" class="panel-label mono" />
                <!-- Grade do mapa -->
                <ui:VisualElement name="mapa-grade" class="mapa-grade" picking-mode="Ignore" />

                <!-- Radar sweep -->
                <ui:VisualElement name="radar-sweep" class="radar-sweep" picking-mode="Ignore" />

                <!-- Canvas onde as unidades são injetadas via C# -->
                <ui:VisualElement name="mapa-unidades-layer" class="mapa-unidades-layer" />

                <!-- SVG-like lines (VisualElements finos) -->
                <ui:VisualElement name="mapa-linhas-layer" class="mapa-linhas-layer" picking-mode="Ignore" />

                <!-- Drawer de seguir -->
                <ui:VisualElement name="painel-seguir" class="seguir-drawer">
                    <ui:VisualElement class="seguir-header">
                        <ui:Label name="seguir-titulo" text="SEGUIR / ALVOS" class="panel-label mono" />
                        <ui:Button name="btn-fechar-seguir" text="X" class="seguir-fechar mono" />
                    </ui:VisualElement>

                    <ui:VisualElement class="seguir-distancias">
                        <ui:Button name="seguir-dist-100" text="100m" class="seguir-dist-btn mono" />
                        <ui:Button name="seguir-dist-200" text="200m" class="seguir-dist-btn mono" />
                        <ui:Button name="seguir-dist-2000" text="2000m" class="seguir-dist-btn mono" />
                        <ui:Button name="seguir-dist-5000" text="5000m" class="seguir-dist-btn mono" />
                    </ui:VisualElement>

                    <ui:Label name="seguir-status" text="Clique em SEGUIR e escolha um alvo" class="seguir-status mono" />

                    <ui:ScrollView name="seguir-scroll" class="seguir-scroll" vertical-scroller-visibility="AlwaysVisible">
                        <ui:VisualElement name="seguir-lista" class="seguir-lista" />
                    </ui:ScrollView>
                </ui:VisualElement>

                <!-- Barra de seleção sempre acima das camadas do mapa -->
                <ui:VisualElement name="mapa-selecao-barra" class="mapa-selecao-barra">
                    <ui:Button name="btn-selecionar-tudo" text="SELECIONAR TUDO [A]" class="btn-selecionar-tudo mono" />
                    <ui:Button name="btn-desselecionar-tudo" text="DESSELECIONAR ATUAL" class="btn-desselecionar-tudo mono" />
                    <ui:Label name="selecao-resumo" text="✓ NENHUMA UNIDADE SELECIONADA" class="selecao-resumo mono" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- PAINEL DIREITO: CÂMERA FLIR -->
            <ui:VisualElement name="painel-flir" class="rts-panel painel-flir">
                <!-- Background da câmera (RenderTexture injetado via C#) -->
                <ui:VisualElement name="flir-imagem" class="flir-imagem" picking-mode="Ignore" />

                <!-- Noise overlay -->
                <ui:VisualElement name="flir-noise" class="flir-noise" picking-mode="Ignore" />

                <!-- Mira / Crosshair -->
                <ui:VisualElement name="flir-crosshair" class="flir-crosshair" picking-mode="Ignore">
                    <ui:VisualElement name="crosshair-h" class="crosshair-h" />
                    <ui:VisualElement name="crosshair-v" class="crosshair-v" />
                    <ui:VisualElement name="crosshair-box" class="crosshair-box" />
                </ui:VisualElement>

                <!-- Overlays de texto da câmera -->
                <ui:VisualElement name="flir-overlay" class="flir-overlay" picking-mode="Ignore">
                    <ui:Label name="flir-label-tl" text="FLIR / AUTO-TRK" class="flir-text flir-tl mono" />
                    <ui:Label name="flir-label-tc" text="HDG 110.9°" class="flir-text flir-tc mono" />
                    <ui:Label name="flir-label-tr" text="ZOOM: 2.5X" class="flir-text flir-tr mono" />
                    <ui:Label name="flir-label-bc" text="" class="flir-text flir-bc mono flir-alert" />
                    <ui:Label name="flir-unidade-nome" text="— SEM ALVO —" class="flir-unidade-nome mono" />
                </ui:VisualElement>

                <!-- ZOOM SLIDER (Alavanca Visual) -->
                <ui:Slider name="flir-zoom-slider" low-value="0" high-value="100" value="50" direction="Vertical" class="flir-zoom-slider" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ÁREA INFERIOR: 4 painéis -->
        <ui:VisualElement name="area-inferior" class="area-inferior" picking-mode="Ignore">

            <!-- PAINEL 1: Telemetria da Unidade Selecionada -->
            <ui:VisualElement name="painel-telemetria" class="rts-panel painel-bottom">
                <ui:Label text="◈ UNIDADE" class="panel-label mono" />

                <ui:VisualElement name="unidade-header" class="unidade-header">
                    <ui:Label name="unidade-emoji" text="✈️" class="unidade-emoji" />
                    <ui:Label name="unidade-nome" text="NENHUMA" class="unidade-nome mono" />
                </ui:VisualElement>

                <ui:VisualElement class="stat-grid">
                    <ui:VisualElement class="stat-row">
                        <ui:Label text="TIPO:" class="stat-lbl" />
                        <ui:Label name="stat-tipo" text="—" class="stat-val" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-row">
                        <ui:Label text="STATUS:" class="stat-lbl" />
                        <ui:Label name="stat-status" text="—" class="stat-val stat-ok stat-armas-live" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-row">
                        <ui:Label text="POSIÇÃO:" class="stat-lbl" />
                        <ui:Label name="stat-pos" text="—" class="stat-val" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-row">
                        <ui:Label text="ARMAS:" class="stat-lbl" />
                        <ui:Label name="stat-armas" text="—" class="stat-val stat-armas-live" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-row">
                        <ui:Label text="TEAM:" class="stat-lbl" />
                        <ui:Label name="stat-team" text="—" class="stat-val" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="progress-row">
                    <ui:Label text="HP" class="progress-lbl mono" />
                    <ui:VisualElement class="progress-track">
                        <ui:VisualElement name="hp-bar" class="progress-fill hp-fill" />
                    </ui:VisualElement>
                    <ui:Label name="hp-valor" text="100%" class="progress-val mono" />
                </ui:VisualElement>

                <ui:VisualElement class="progress-row">
                    <ui:Label text="COMB." class="progress-lbl mono" />
                    <ui:VisualElement class="progress-track">
                        <ui:VisualElement name="fuel-bar" class="progress-fill fuel-fill" />
                    </ui:VisualElement>
                    <ui:Label name="fuel-valor" text="—%" class="progress-val mono" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- PAINEL 2: SITREP Global -->
            <ui:VisualElement name="painel-sitrep" class="rts-panel painel-bottom">
                <ui:Label text="◈ SITREP" class="panel-label mono" />

                <ui:VisualElement class="sitrep-row">
                    <ui:Label text="Forças Aliadas:" class="stat-lbl" />
                    <ui:Label name="sitrep-aliados" text="0" class="stat-val sitrep-valor sitrep-aliados" />
                </ui:VisualElement>
                <ui:VisualElement class="sitrep-row">
                    <ui:Label text="Forças Hostis:" class="stat-lbl" />
                    <ui:Label name="sitrep-inimigos" text="0" class="stat-val sitrep-valor sitrep-inimigos" />
                </ui:VisualElement>
                <ui:VisualElement class="sitrep-row">
                    <ui:Label text="Velocidade:" class="stat-lbl" />
                    <ui:Label name="sitrep-vel" text="0 km/h" class="stat-val sitrep-valor sitrep-vel" />
                </ui:VisualElement>
                <ui:VisualElement class="sitrep-row">
                    <ui:Label text="Combustível:" class="stat-lbl" />
                    <ui:Label name="sitrep-fuel" text="0%" class="stat-val sitrep-valor sitrep-fuel" />
                </ui:VisualElement>
                <ui:VisualElement class="sitrep-row sitrep-separator">
                    <ui:Label text="Ameaça do Setor:" class="stat-lbl" />
                    <ui:Label name="sitrep-ameaca" text="MEDIA" class="stat-val sitrep-valor sitrep-ameaca" />
                </ui:VisualElement>
                <ui:VisualElement class="sitrep-row">
                    <ui:Label text="Unid. Selecionada:" class="stat-lbl" />
                    <ui:Label name="sitrep-sel" text="—" class="stat-val sitrep-valor sitrep-sel" />
                </ui:VisualElement>
                <ui:VisualElement class="sitrep-row">
                    <ui:Label text="Tempo de Op.:" class="stat-lbl" />
                    <ui:Label name="sitrep-tempo" text="00:00:00" class="stat-val sitrep-valor sitrep-tempo mono" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- PAINEL 3: Log de Comunicações -->
            <ui:VisualElement name="painel-log" class="rts-panel painel-bottom">
                <ui:Label text="◈ REDE TÁTICA" class="panel-label mono" />
                <ui:ScrollView name="log-scroll" class="log-scroll" vertical-scroller-visibility="AlwaysVisible">
                    <ui:VisualElement name="log-container" class="log-container" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- PAINEL 4: Ordens -->
                <ui:VisualElement name="painel-ordens" class="rts-panel painel-bottom painel-ordens">
                <ui:Label text="◈ ORDENS" class="panel-label mono" />

                <ui:VisualElement class="ordens-grid">
                    <ui:VisualElement class="ordens-row">
                        <ui:Button name="btn-ativo" text="⚔️ ATIVO" class="ordem-btn btn-ativo mono" />
                        <ui:Button name="btn-estado" text="↔ ESTADO (ALTERNAR) [I]" class="ordem-btn btn-estado mono" />
                    </ui:VisualElement>
                    <ui:VisualElement class="ordens-row">
                        <ui:Button name="btn-passivo" text="🛡 PASSIVO" class="ordem-btn btn-passivo mono" />
                        <ui:Button name="btn-lancar-missil" text="🚀 LANÇAR MÍSSIL [ÁREA]" class="ordem-btn btn-lancar-missil mono" />
                    </ui:VisualElement>
                    <ui:VisualElement class="ordens-row">
                        <ui:Button name="btn-troca-camera" text="📷 CÂMERA" class="ordem-btn btn-seguir mono" />
                        <ui:Button name="btn-mover" text="➤ MOVER" class="ordem-btn btn-mover mono" />
                    </ui:VisualElement>
                    <ui:VisualElement class="ordens-row">
                        <ui:Button name="btn-patrulhar" text="🔄 PATRULHAR" class="ordem-btn btn-patrulhar mono" />
                        <ui:Button name="btn-seguir" text="👁 SEGUIR" class="ordem-btn btn-seguir mono" />
                        <ui:Button name="btn-radar-unidade" text="R" class="radar-mini mono" tooltip="Ligar/desligar radar da unidade" />
                    </ui:VisualElement>
                    <ui:VisualElement class="ordens-row">
                        <ui:Button name="btn-atacar" text="🎯 ATACAR" class="ordem-btn btn-atacar mono" />
                        <ui:Button name="btn-voltar-base" text="🏠 VOLTAR" class="ordem-btn btn-passivo mono" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="ordens-status" picking-mode="Ignore">
                    <ui:Label name="ordem-feedback" text="Selecione uma unidade no mapa" class="ordem-feedback mono" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

    <!-- Barra contextual persistente. O menu tático continua sendo aberto pela tecla 1. -->
    <ui:VisualElement name="barra-comando-contextual" class="barra-comando-contextual" picking-mode="Position">
        <ui:VisualElement class="contexto-modulos">
            <ui:VisualElement class="tactical-card identity-card"><ui:VisualElement class="identity-heading"><ui:VisualElement name="hud-country" class="country-flag" tooltip="Bandeira do país da unidade"><ui:VisualElement name="hud-flag-top" class="flag-stripe"/><ui:VisualElement name="hud-flag-middle" class="flag-stripe"/><ui:VisualElement name="hud-flag-bottom" class="flag-stripe"/></ui:VisualElement><ui:VisualElement class="identity-titles"><ui:Label name="contexto-tipo" text="UNIDADE / AGUARDANDO" class="card-title mono"/><ui:Label name="contexto-unidade" text="NENHUMA UNIDADE" class="identity-name mono"/></ui:VisualElement></ui:VisualElement><ui:VisualElement class="identity-info"><ui:VisualElement name="hud-preview" class="unit-preview"/><ui:VisualElement class="identity-meters"><ui:Label name="hud-status" text="SELECT A UNIT" class="status-green mono"/><ui:VisualElement class="vital-row"><ui:Label name="hud-integrity" text="HP  —" class="card-copy mono"/><ui:VisualElement class="meter"><ui:VisualElement name="hud-integrity-fill" class="meter-fill green-fill"/></ui:VisualElement></ui:VisualElement><ui:VisualElement class="vital-row"><ui:Label name="hud-readiness" text="FUEL  —" class="card-copy mono"/><ui:VisualElement class="meter"><ui:VisualElement name="hud-readiness-fill" class="meter-fill cyan-fill"/></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="tactical-card speed-card"><ui:Label name="hud-card-speed" text="VELOCIDADE / RUMO" class="card-title mono"/><ui:Label name="hud-speed" text="VEL  —" class="card-value mono"/><ui:Label name="hud-heading" text="PROA  —" class="card-copy mono"/><ui:VisualElement name="hud-speed-controls" class="hud-speed-controls"><ui:Button name="hud-speed-down" text="− 10%" class="hud-speed-adjust mono"/><ui:Label name="hud-speed-order" text="GRUPO 100%" class="hud-speed-order mono"/><ui:Button name="hud-speed-up" text="+ 10%" class="hud-speed-adjust mono"/></ui:VisualElement><ui:VisualElement name="hud-compass" class="compass"><ui:Label name="hud-compass-n" text="N" class="compass-n mono"/><ui:Label name="hud-compass-arrow" text="▲" class="compass-arrow mono"/><ui:Label name="hud-compass-s" text="S" class="compass-s mono"/></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="tactical-card condition-card"><ui:Label name="hud-card-condition" text="CONDIÇÃO DA UNIDADE" class="card-title mono"/><ui:Label name="hud-condition-label" text="ESTADO" class="card-copy mono"/><ui:Label name="hud-condition" text="—" class="card-value status-green mono"/><ui:Label name="hud-condition-detail" text="SEM DADOS" class="card-copy mono"/><ui:Button name="hud-context-rtb" text="BASE  ↗" class="mini-action mono" tooltip="Retornar aeronave à base."/></ui:VisualElement>
            <ui:VisualElement name="formation-card" class="tactical-card formation-card"><ui:Label name="hud-card-formation" text="FORMAÇÃO" class="card-title mono"/><ui:Label name="hud-formation-label" text="SELEÇÃO TÁTICA" class="card-copy mono"/><ui:VisualElement class="formation-widget"><ui:Button name="formation-slot-2" text="2" class="formation-slot" tooltip="Membro 2 — clique para torná-lo líder."/><ui:Button name="formation-slot-3" text="3" class="formation-slot" tooltip="Membro 3 — clique para torná-lo líder."/><ui:Button name="formation-slot-1" text="1" class="formation-slot formation-leader" tooltip="Líder da formação."/><ui:Button name="formation-slot-4" text="4" class="formation-slot" tooltip="Membro 4 — clique para torná-lo líder."/><ui:Button name="formation-slot-5" text="5" class="formation-slot" tooltip="Membro 5 — clique para torná-lo líder."/></ui:VisualElement><ui:Label name="hud-formation-hint" text="F3 EDITAR FORMAÇÃO" class="card-copy mono"/></ui:VisualElement>
            <ui:VisualElement class="tactical-card roe-card"><ui:Label name="hud-card-roe" text="POSTURA / REGRAS DE FOGO" class="card-title mono"/><ui:Button name="hud-roe-hold" text="○  CESSAR FOGO" class="roe-option mono"/><ui:Button name="hud-roe-defensive" text="○  DEFENSIVA" class="roe-option mono"/><ui:Button name="hud-roe-tight" text="○  FOGO RESTRITO" class="roe-option mono"/><ui:Button name="hud-roe-free" text="○  FOGO LIVRE" class="roe-option mono"/></ui:VisualElement>
            <ui:VisualElement class="tactical-card sensors-card"><ui:Label name="hud-card-sensors" text="SENSORES / EMCON" class="card-title mono"/><ui:Button name="hud-radar" text="◉ RADAR          —" class="system-row mono"/><ui:Label name="hud-sonar" text="◎ SONAR          N/D" class="system-row unavailable mono"/><ui:Label name="hud-esm" text="▥ ESM             N/D" class="system-row unavailable mono"/><ui:Label name="hud-datalink" text="⊕ LINK DE DADOS   N/D" class="system-row unavailable mono"/></ui:VisualElement>
            <ui:VisualElement class="tactical-card weapons-card"><ui:Label name="hud-card-weapons" text="ARMAMENTO" class="card-title mono"/><ui:Label name="hud-weapon-1" text="—" class="system-row mono"/><ui:Label name="hud-weapon-2" text="—" class="system-row mono"/><ui:Label name="hud-weapon-3" text="—" class="system-row mono"/><ui:Label name="hud-weapon-4" text="—" class="system-row mono"/><ui:Label name="hud-weapon-5" text="—" class="system-row mono"/></ui:VisualElement>
            <ui:VisualElement class="tactical-card counter-card"><ui:Label name="hud-card-countermeasures" text="CONTRAMEDIDAS" class="card-title mono"/><ui:Label name="hud-counter-1" text="CHAFF            N/D" class="system-row unavailable mono"/><ui:Label name="hud-counter-2" text="ISCA ACÚSTICA    N/D" class="system-row unavailable mono"/><ui:Label name="hud-counter-state" text="SISTEMAS NÃO DETECTADOS" class="card-copy mono"/></ui:VisualElement>
            <ui:VisualElement class="tactical-card waypoint-card"><ui:Label name="hud-card-waypoints" text="PATRULHA / PONTOS DE ROTA" class="card-title mono"/><ui:Label name="hud-waypoints" text="ROTA NÃO DEFINIDA" class="waypoint-graphic mono"/><ui:Label name="hud-waypoint-detail" text="SEM DESTINO ORDENADO" class="card-value mono"/><ui:Button name="btn-contexto-patrulhar" text="F4  PATRULHA" class="mini-action mono" tooltip="Criar rota no mapa tático."/></ui:VisualElement>
            <ui:VisualElement class="tactical-card automation-card"><ui:Label name="hud-card-automation" text="IA / AUTOMAÇÃO" class="card-title mono"/><ui:Button name="hud-ai-manual" text="○  MANUAL" class="roe-option mono"/><ui:Button name="hud-ai-assist" text="○  ASSISTÊNCIA" class="roe-option mono"/><ui:Button name="hud-ai-auto" text="○  AUTOMÁTICO" class="roe-option mono"/><ui:Label name="hud-ai-status" text="MODO N/D" class="card-copy mono"/></ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="contexto-quick-row">
            <ui:Button name="btn-contexto-seguir" text="⌘  SEGUIR   F1" class="quick-action mono" tooltip="Escolher unidade para acompanhar."/>
            <ui:Button name="quick-escort" text="♟  ESCOLTAR   F2" class="quick-action mono" tooltip="Escolha uma unidade para escoltar a selecionada."/>
            <ui:Button name="quick-formation" text="✥  EDITAR FORMAÇÃO   F3" class="quick-action mono" tooltip="Ativar ou concluir a edição dos slots da formação."/>
            <ui:Button name="quick-patrol" text="⌖  PATRULHA   F4" class="quick-action mono" tooltip="Criar rota de patrulha."/>
            <ui:Button name="quick-intercept" text="◎  INTERCEPTAR   F5" class="quick-action mono" tooltip="Selecionar alvo para interceptar."/>
            <ui:Button name="quick-damage" text="⚒  CONTROLE DE DANOS   F6" class="quick-action mono" tooltip="Exibir o diagnóstico de integridade da unidade em foco."/>
            <ui:Button name="quick-camera" text="▣  CÂMERA   F7" class="quick-action mono" tooltip="Centralizar câmera na seleção."/>
            <ui:Button name="btn-contexto-centro" text="☰" class="utility-action mono" tooltip="Abrir centro tático."/>
            <ui:Button name="quick-grid" text="▦" class="utility-action mono" tooltip="Aplicar formação em grade às unidades selecionadas."/>
            <ui:Button name="quick-camera-options" text="▣" class="utility-action mono" tooltip="Alternar câmera de acompanhamento."/>
            <ui:Button name="btn-hud-fechar" text="×" class="utility-action hud-close-button mono" tooltip="Recolher a barra tática."/>
        </ui:VisualElement>
        <ui:Label name="contexto-feedback" text="" class="contexto-feedback mono" />
    </ui:VisualElement>
    <ui:VisualElement name="hud-dock-reabrir" class="hud-dock-reabrir" picking-mode="Position">
        <ui:Button name="btn-hud-reabrir" text="☰  REABRIR HUD TÁTICO" class="hud-restore-button mono" tooltip="Reabrir a barra tática."/>
    </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

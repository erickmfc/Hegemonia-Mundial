/* MIL-SIM UI STYLES */

.milsim-root {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    background-color: #090c09; /* C.bg */
    display: flex;
    flex-direction: column;
    -unity-font-definition: initial; /* Use default font or a monospace one if assigned */
}

/* TOP HALF: CAMERAS */
.milsim-top-area {
    flex-grow: 1;
    display: flex;
    flex-direction: row;
    overflow: hidden;
}

.milsim-map-view {
    flex-grow: 1;
    position: relative;
    border-right-width: 1px;
    border-right-color: #162416; /* C.border */
    background-color: #14202e; /* C.bgMap */
    display: flex;
    flex-direction: column;
}

.milsim-3d-view {
    flex-grow: 1;
    position: relative;
    background-color: #7a8ea0; /* View3D background from react */
    overflow: hidden;
}

.milsim-viewport {
    flex-grow: 1;
    position: relative;
}

.milsim-map-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* BOTTOM HALF: PANEL */
.milsim-bottom-panel {
    height: 200px;
    background-color: #0b0e0b; /* C.bgPanel */
    border-top-width: 2px;
    border-top-color: #1e3a1e; /* C.borderBright */
    display: flex;
    flex-direction: row;
    overflow: hidden;
}

/* PANEL COLUMNS */
.milsim-col {
    padding: 8px 10px;
    border-right-width: 1px;
    border-right-color: #162416; /* C.border */
    display: flex;
    flex-direction: column;
}

.col-unit { width: 230px; }
.col-speed-alt { width: 220px; }
.col-roe { width: 195px; }
.col-weapons { width: 220px; }
.col-comms { flex-grow: 1; border-right-width: 0; } /* Last col has no right border */

/* TEXT STYLES */
.txt-bright { color: #b8e090; }
.txt-normal { color: #90b870; }
.txt-muted { color: #506840; }
.txt-dim { color: #2e4a2e; }
.txt-label {
    font-size: 9px;
    color: #506840; /* C.textMuted */
    letter-spacing: 2px;
    margin-bottom: 6px;
    -unity-text-align: upper-left;
}

/* BUTTONS */
.milsim-btn {
    padding: 5px 10px;
    font-size: 10px;
    cursor: link;
    background-color: transparent;
    color: #506840; /* C.textMuted */
    border-width: 1px;
    border-color: #162416; /* C.border */
    border-radius: 0;
    margin: 0;
    -unity-text-align: middle-center;
}

.milsim-btn:hover {
    background-color: rgba(10, 42, 10, 0.5); /* C.activeBg with alpha */
}

.milsim-btn.active {
    background-color: #0a2a0a; /* C.activeBg */
    color: #6af040; /* C.activeTxt */
    border-color: #2a8020; /* C.activeBorder */
}

/* SPECIFIC LAYOUTS */
.flex-row {
    display: flex;
    flex-direction: row;
}

.gap-4 { margin-right: 4px; }
.gap-8 { margin-right: 8px; }

/* MAP ICONS */
.map-icon {
    position: absolute;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    margin-top: -3px;
}

.map-icon-friendly { background-color: #3a90ff; }
.map-icon-enemy { background-color: #ff3838; }
.map-icon-selected { 
    background-color: #ffcc00; 
    border-width: 1px;
    border-color: #ffffff;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    margin-top: -4px;
}

/* ROE DROPDOWN (Simulated) */
.roe-row {
    margin-bottom: 6px;
}
.roe-label {
    font-size: 9px;
    color: #2e4a2e; /* C.textDim */
    margin-bottom: 2px;
}
.roe-dropdown-btn {
    background-color: transparent;
    border-width: 0;
    color: #506840; /* C.textMuted */
    font-size: 10px;
    padding: 2px 4px;
    -unity-text-align: middle-left;
}
.roe-dropdown-btn:hover {
    color: #90b870;
}

/* RADAR BUTTONS */
.radar-on {
    background-color: #001e00;
    color: #00ff44;
    border-color: #00882a;
    border-right-width: 0;
}
.radar-off {
    background-color: #1e0000;
    color: #ff4444;
    border-color: #882000;
}

/* COMMS LOG */
.comms-scroll {
    flex-grow: 1;
    margin-bottom: 6px;
}
.comms-entry {
    font-size: 10px;
    margin-bottom: 2px;
}
.comms-time { color: #2e4a2e; }
.comms-unit { color: #90b870; }
.comms-msg { color: #506840; }

.bottom-actions {
    display: flex;
    flex-direction: row;
    border-top-width: 1px;
    border-top-color: #162416;
    padding-top: 6px;
}
.bottom-actions .milsim-btn {
    flex-grow: 1;
    margin-right: 4px;
    font-size: 9px;
}

/* ============================================================
   MENU COMANDO TÁTICO — USS Theme
   Baseado no protótipo HTML/CSS tático com tema ciano escuro
   ============================================================ */

/* --- VARIÁVEIS GLOBAIS (via classes utilitárias) --- */
/* --primary: #00e5ff  --enemy: #ff3333  --alert: #ffaa00 */

/* --- ROOT --- */
.menu-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    flex-direction: column;
    background-color: rgba(5, 9, 12, 0.0); /* Transparent to allow seeing the 3D map */
    padding: 12px;
    gap: 10px;
}

/* --- OVERLAY CRT (scanlines) --- */
.crt-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* --- TIPOGRAFIA --- */
.mono {
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* --- HEADER --- */
.header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 229, 255, 0.3);
    padding-bottom: 8px;
    height: 36px;
    flex-shrink: 0;
}

.header-titulo {
    color: rgb(0, 229, 255);
    font-size: 15px;
    -unity-font-style: bold;
}

.header-center {
    flex-direction: row;
    align-items: center;
}

.header-status {
    color: rgb(0, 229, 255);
    font-size: 11px;
    opacity: 0.8;
}

.header-tempo {
    color: rgb(107, 139, 153);
    font-size: 12px;
}

.menu-fechar {
    min-width: 86px;
    height: 28px;
    margin-right: 8px;
    align-self: center;
    border-width: 1px;
    border-color: rgb(0, 190, 220);
    background-color: rgb(10, 45, 60);
    color: rgb(230, 250, 255);
    font-size: 11px;
}

.menu-fechar:hover {
    background-color: rgb(20, 90, 110);
}

/* --- PAINEL BASE (rts-panel) --- */
.rts-panel {
    background-color: rgba(10, 16, 22, 0.88);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.3);
    border-radius: 3px;
    overflow: hidden;
    position: relative;
}

/* Brilho no topo via borda (USS não suporta ::before) */
.rts-panel {
    border-top-width: 1px;
    border-top-color: rgba(0, 229, 255, 0.5);
}

/* --- CORPO PRINCIPAL (Mapa + FLIR) --- */
.corpo-principal {
    flex-direction: row;
    gap: 10px;
    flex: 1;
    min-height: 0;
}

/* --- PAINEL DO MAPA --- */
.painel-mapa {
    flex: 1.3;
    position: relative;
    background-color: rgb(11, 20, 26);
    overflow: hidden;
}

.seguir-drawer {
    position: absolute;
    left: 10px;
    top: 42px;
    width: 270px;
    bottom: 10px;
    background-color: rgba(5, 10, 14, 0.94);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.35);
    border-radius: 4px;
    padding: 8px;
    gap: 6px;
    display: none;
    flex-direction: column;
}

.seguir-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    flex-shrink: 0;
}

.seguir-fechar {
    width: 24px;
    height: 24px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.35);
    color: rgb(0, 229, 255);
    background-color: rgba(0, 0, 0, 0.35);
}

.seguir-fechar:hover {
    border-color: rgb(0, 229, 255);
}

.seguir-distancias {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 5px;
    flex-shrink: 0;
}

.seguir-dist-btn {
    width: 48%;
    height: 30px;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.35);
    border-radius: 2px;
    background-color: rgba(0, 32, 44, 0.7);
    color: rgb(0, 229, 255);
    font-size: 10px;
}

.seguir-dist-btn.ativo {
    background-color: rgba(0, 120, 160, 0.8);
    border-color: rgb(0, 229, 255);
    color: rgb(255, 255, 255);
}

.seguir-status {
    color: rgb(107, 139, 153);
    font-size: 9px;
    flex-shrink: 0;
    white-space: normal;
}

.seguir-scroll {
    flex: 1;
    min-height: 0;
}

.seguir-lista {
    flex-direction: column;
    gap: 5px;
    padding-right: 2px;
}

.seguir-item {
    min-height: 36px;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.25);
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.35);
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 5px;
    padding-bottom: 5px;
    justify-content: center;
    transition-duration: 0.14s;
    transition-property: background-color, border-color, scale, translate;
}

.seguir-item:hover {
    border-color: rgb(0, 229, 255);
    background-color: rgba(0, 48, 64, 0.8);
}

.seguir-item.ativo {
    border-color: rgb(255, 220, 0);
    background-color: rgba(48, 42, 0, 0.9);
    scale: 1.02;
}

.seguir-item.seguir-item-pulse {
    border-color: rgb(255, 245, 120);
    background-color: rgba(86, 76, 0, 0.98);
    scale: 1.05;
    translate: 0 -1px;
}

.seguir-item-nome {
    color: rgb(0, 229, 255);
    font-size: 11px;
    -unity-font-style: bold;
}

.seguir-item-meta {
    color: rgb(180, 200, 210);
    font-size: 9px;
}

.panel-label {
    color: rgb(107, 139, 153);
    font-size: 11px;
    -unity-font-style: bold;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 229, 255, 0.2);
    padding: 5px 8px;
    letter-spacing: 2px;
    flex-shrink: 0;
}

/* Grade do mapa */
.mapa-grade {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* Radar sweep */
.radar-sweep {
    position: absolute;
    top: 50%; left: 50%;
    width: 200%;
    height: 2px;
    background-color: rgba(0, 229, 255, 0.4);
    transform-origin: left center;
    opacity: 0.35;
    /* Animação via C# (rotate) */
}

/* Layer das unidades */
.mapa-unidades-layer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.mapa-linhas-layer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* --- MARCADORES DE UNIDADE NO MAPA --- */
.mapa-unidade {
    position: absolute;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    /* offset para centralizar */
    margin-left: -21px;
    margin-top: -21px;
}

.mapa-unidade.controlavel .mapa-marcador {
    border-color: rgb(255, 220, 0);
}

.mapa-marcador {
    width: 22px;
    height: 22px;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    background-color: rgba(0, 0, 0, 0.7);
    border-width: 2px;
    border-radius: 3px;
}

.mapa-marcador.amigo {
    border-color: rgb(0, 229, 255);
    color: rgb(0, 229, 255);
}

.mapa-marcador.inimigo {
    border-color: rgb(255, 51, 51);
    color: rgb(255, 51, 51);
    rotate: 45deg;
}

.mapa-marcador.destruido {
    border-color: rgb(85, 85, 85);
    color: rgb(85, 85, 85);
    opacity: 0.5;
}

.mapa-label {
    position: absolute;
    top: -18px;
    font-size: 9px;
    -unity-font-style: bold;
    white-space: nowrap;
    background-color: rgba(0, 0, 0, 0.85);
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-width: 1px;
}

.mapa-label.amigo {
    color: rgb(0, 229, 255);
    border-color: rgb(0, 229, 255);
}

.mapa-label.inimigo {
    color: rgb(255, 51, 51);
    border-color: rgb(255, 51, 51);
}

.mapa-label.selecionado {
    color: rgb(255, 255, 0);
    border-color: rgb(255, 255, 0);
}

.mapa-label.foco {
    color: rgb(255, 255, 255);
    border-color: rgb(255, 255, 255);
    background-color: rgba(255, 190, 0, 0.45);
}

/* Imóveis: presença no mapa sem texto grande e sem aglomerar rótulos. */
.mapa-label.imovel {
    width: 9px;
    height: 9px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 8px;
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0.7);
    -unity-text-align: middle-center;
}

.mapa-marcador.selecionado {
    border-color: rgb(255, 225, 0);
    color: rgb(255, 225, 0);
    background-color: rgba(120, 90, 0, 0.72);
}

.mapa-marcador.foco {
    border-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    background-color: rgba(255, 170, 0, 0.78);
}

/* Mini barra de HP no mapa */
.mapa-hp-track {
    position: absolute;
    bottom: -6px;
    left: 0; right: 0;
    height: 3px;
    background-color: rgb(30, 30, 30);
}

.mapa-hp-fill {
    height: 100%;
}

.mapa-hp-fill.amigo { background-color: rgb(0, 229, 255); }
.mapa-hp-fill.inimigo { background-color: rgb(255, 51, 51); }

/* Anel de seleção */
.mapa-sel-ring {
    position: absolute;
    top: -4px; left: -4px; right: -4px; bottom: -4px;
    border-width: 2px;
    border-color: rgb(255, 220, 0);
    border-radius: 50%;
    opacity: 0;
}

.mapa-sel-ring.visivel {
    opacity: 1;
    border-width: 3px;
    scale: 1.12 1.12;
}

.ordem-selecionada {
    border-color: rgb(255, 224, 72);
    background-color: rgba(255, 190, 0, 0.38);
    color: rgb(255, 255, 255);
    scale: 1.03 1.03;
}

/* --- PAINEL FLIR --- */
.painel-flir {
    flex: 1;
    position: relative;
    background-color: rgb(10, 10, 10);
    overflow: hidden;
    border-color: rgba(100, 100, 100, 0.4);
}

/* Imagem da câmera (RenderTexture) */
.flir-imagem {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0.9;
}

/* Noise overlay */
.flir-noise {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* Crosshair */
.flir-crosshair {
    position: absolute;
    top: 50%; left: 50%;
    width: 140px; height: 140px;
    margin-left: -70px;
    margin-top: -70px;
}

.crosshair-h {
    position: absolute;
    top: 50%;
    left: -20px; right: -20px;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.75);
    margin-top: -0.5px;
}

.crosshair-v {
    position: absolute;
    left: 50%;
    top: -20px; bottom: -20px;
    width: 1px;
    background-color: rgba(255, 255, 255, 0.75);
    margin-left: -0.5px;
}

.crosshair-box {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.45);
}

/* Overlay de texto do FLIR */
.flir-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.flir-text {
    position: absolute;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.9);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.flir-tl { top: 10px; left: 10px; }
.flir-tc { top: 10px; left: 50%; translate: -50% 0; }
.flir-tr { top: 10px; right: 10px; }
.flir-bc { bottom: 22px; left: 50%; translate: -50% 0; color: rgb(255, 170, 0); }

.flir-unidade-nome {
    position: absolute;
    bottom: 8px;
    right: 10px;
    font-size: 10px;
    color: rgb(0, 229, 255);
}

.flir-alert {
    color: rgb(255, 170, 0);
}

/* --- ÁREA INFERIOR --- */
.area-inferior {
    flex-direction: row;
    gap: 10px;
    height: 220px;
    flex-shrink: 0;
}

.painel-bottom {
    flex: 1;
    padding-top: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    overflow: hidden;
    flex-direction: column;
    gap: 5px;
}

/* O painel de ordens tem cinco linhas com as acoes restantes. Mantemos
   espacamento compacto para que a ultima linha e o feedback nunca sejam
   cortados pela altura fixa da faixa inferior. */
.painel-ordens {
    padding-top: 6px;
    padding-bottom: 6px;
    gap: 3px;
}

/* --- TELEMETRIA DA UNIDADE --- */
.unidade-header {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    flex-shrink: 0;
}

.unidade-emoji {
    font-size: 20px;
}

.unidade-nome {
    color: rgb(0, 229, 255);
    font-size: 16px;
    -unity-font-style: bold;
    flex: 1;
}

.stat-grid {
    flex-direction: column;
    margin-top: 4px;
    gap: 2px;
    flex-shrink: 0;
}

.stat-row {
    flex-direction: row;
    align-items: center;
}

.stat-lbl {
    color: rgb(107, 139, 153);
    font-size: 11px;
    width: 55px;
}

.stat-val {
    color: rgb(208, 232, 240);
    font-size: 11px;
    -unity-font-style: bold;
    flex: 1;
    padding-top: 3px;
    padding-bottom: 3px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.stat-armas-live {
    white-space: normal;
    font-size: 9px;
    padding-top: 1px;
    padding-bottom: 1px;
}

.stat-ok { color: rgb(0, 229, 255); }
.stat-alert { color: rgb(255, 170, 0); }
.stat-danger { color: rgb(255, 51, 51); }

.progress-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    height: 16px;
    flex-shrink: 0;
}

.progress-lbl {
    font-size: 10px;
    color: rgb(107, 139, 153);
    -unity-font-style: bold;
    width: 45px;
}

.progress-track {
    flex: 1;
    height: 8px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.2);
    margin-left: 6px;
    margin-right: 6px;
    border-radius: 2px;
}

.progress-fill {
    height: 100%;
}

.progress-val {
    font-size: 10px;
    color: rgb(208, 232, 240);
    -unity-font-style: bold;
    width: 35px;
    -unity-text-align: middle-right;
}

.hp-fill { background-color: rgb(0, 229, 255); }
.fuel-fill { background-color: rgb(243, 156, 18); }

/* --- SITREP --- */
.sitrep-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 0;
}

.sitrep-row .stat-lbl {
    width: 118px;
    font-size: 12px;
    color: rgb(146, 175, 186);
    -unity-font-style: bold;
}

.sitrep-separator {
    border-top-width: 1px;
    border-top-color: rgba(0, 229, 255, 0.15);
    margin-top: 4px;
    padding-top: 6px;
}

.sitrep-valor {
    color: rgb(245, 250, 255);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    background-color: rgba(0, 0, 0, 0.42);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.16);
    border-radius: 3px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 2px;
    padding-bottom: 2px;
    min-height: 20px;
}

.sitrep-aliados { color: rgb(0, 229, 255); font-size: 15px; }
.sitrep-inimigos { color: rgb(255, 51, 51); font-size: 15px; }
.sitrep-ameaca { color: rgb(255, 170, 0); font-size: 12px; }
.sitrep-fuel { color: rgb(255, 200, 120); }
.sitrep-vel { color: rgb(225, 238, 245); }
.sitrep-sel { color: rgb(220, 242, 248); }
.sitrep-tempo { color: rgb(210, 230, 238); }

/* --- LOG DE COMUNICAÇÕES --- */
.log-scroll {
    flex: 1;
    min-height: 0;
}

.log-scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical {
    width: 6px;
}

.log-scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical > .unity-base-slider__tracker {
    background-color: rgba(0,0,0,0.3);
}

.log-scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical > .unity-base-slider__dragger {
    background-color: rgba(0, 229, 255, 0.4);
    border-radius: 2px;
}

.log-container {
    flex-direction: column;
    gap: 4px;
    padding-right: 4px;
}

.log-entry {
    flex-direction: column;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
    padding-bottom: 3px;
}

.log-linha {
    flex-direction: row;
    flex-wrap: wrap;
}

.log-time {
    color: rgb(107, 139, 153);
    font-size: 9px;
    margin-right: 4px;
}

.log-source {
    color: rgb(0, 229, 255);
    font-size: 9px;
    -unity-font-style: bold;
    margin-right: 4px;
}

.log-source.inimigo { color: rgb(255, 51, 51); }
.log-source.sistema { color: rgb(255, 170, 0); }

.log-msg {
    color: rgb(180, 200, 210);
    font-size: 9px;
}

/* --- ORDENS --- */
.ordens-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 6px;
}

.painel-ordens .ordens-grid {
    gap: 3px;
    margin-top: 3px;
}

.ordem-btn {
    flex: 1;
    min-width: 45%;
    height: 34px;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.4);
    border-radius: 2px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    transition-duration: 0.15s;
    transition-property: background-color, border-color;
}

.painel-ordens .ordem-btn {
    height: 30px;
    min-height: 30px;
}

.ordem-btn:hover {
    border-width: 1px;
}

.btn-ativo {
    background-color: rgba(180, 0, 0, 0.35);
    color: rgb(255, 100, 100);
    border-color: rgba(255, 51, 51, 0.6);
}
.btn-ativo:hover {
    background-color: rgba(200, 20, 20, 0.55);
    border-color: rgb(255, 51, 51);
}

.btn-passivo {
    background-color: rgba(0, 80, 180, 0.35);
    color: rgb(100, 180, 255);
    border-color: rgba(0, 150, 255, 0.5);
}
.btn-passivo:hover {
    background-color: rgba(0, 100, 200, 0.55);
    border-color: rgb(0, 229, 255);
}

.btn-estado {
    background-color: rgba(0, 130, 150, 0.35);
    color: rgb(120, 245, 245);
    border-color: rgba(0, 220, 220, 0.65);
}
.btn-estado:hover {
    background-color: rgba(0, 170, 180, 0.55);
    border-color: rgb(0, 255, 255);
}

.btn-lancar-missil {
    background-color: rgba(170, 45, 15, 0.42);
    color: rgb(255, 190, 100);
    border-color: rgba(255, 125, 35, 0.75);
}
.btn-lancar-missil:hover {
    background-color: rgba(220, 65, 20, 0.62);
    border-color: rgb(255, 210, 120);
}

.btn-patrulhar {
    background-color: rgba(160, 80, 0, 0.35);
    color: rgb(255, 170, 80);
    border-color: rgba(255, 130, 0, 0.5);
}
.btn-patrulhar:hover {
    background-color: rgba(180, 100, 0, 0.55);
    border-color: rgb(255, 170, 0);
}

.btn-seguir {
    background-color: rgba(100, 0, 140, 0.35);
    color: rgb(200, 120, 255);
    border-color: rgba(160, 50, 200, 0.5);
}
.btn-seguir:hover {
    background-color: rgba(130, 20, 170, 0.55);
    border-color: rgb(200, 80, 255);
}

.btn-atacar {
    background-color: rgba(220, 20, 60, 0.35);
    color: rgb(255, 80, 100);
    border-color: rgba(255, 30, 80, 0.5);
}
.btn-atacar:hover {
    background-color: rgba(255, 30, 80, 0.55);
    border-color: rgb(255, 50, 100);
}

.ordens-status {
    margin-top: 6px;
    padding-top: 8px;
    picking-mode: ignore;
}

.ordem-feedback {
    color: rgb(107, 139, 153);
    font-size: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* --- BLINK ANIMATION (via opacity) --- */
.blink {
    opacity: 1;
    /* Animado via C# toggling opacity */
}

/* --- BOTÃO SELECIONAR TUDO (FLUTUANTE NO MAPA) --- */
.mapa-selecao-barra {
    position: absolute;
    width: 570px;
    height: 22px;
    left: 480px;
    top: 42px;
    flex-direction: row;
    align-items: center;
}

.btn-selecionar-tudo {
    position: relative;
    width: 115px;
    height: 18px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(5, 9, 12, 0.85);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.4);
    border-radius: 2px;
    color: rgb(0, 229, 255);
    font-size: 8px;
    transition-duration: 0.12s;
    transition-property: background-color;
}

.btn-selecionar-tudo:hover {
    background-color: rgba(0, 229, 255, 0.25);
    border-color: rgb(0, 229, 255);
}

.btn-desselecionar-tudo {
    position: relative;
    width: 142px;
    margin-left: 4px;
    height: 18px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(35, 8, 8, 0.9);
    border-width: 1px;
    border-color: rgba(255, 90, 90, 0.55);
    border-radius: 2px;
    color: rgb(255, 150, 150);
    font-size: 8px;
}

.btn-desselecionar-tudo:hover {
    background-color: rgba(255, 60, 60, 0.25);
    border-color: rgb(255, 90, 90);
    color: rgb(255, 220, 220);
}

.selecao-resumo {
    position: relative;
    flex-grow: 1;
    min-width: 80px;
    margin-left: 4px;
    height: 18px;
    overflow: hidden;
    white-space: nowrap;
    color: rgb(255, 230, 70);
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

/* --- ZOOM SLIDER --- */
.flir-zoom-slider {
    position: absolute;
    top: 40px;
    bottom: 50px;
    right: 15px;
    width: 20px;
}

.flir-zoom-slider .unity-base-slider__tracker {
    background-color: rgba(0, 50, 70, 0.6);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.4);
    border-radius: 3px;
    width: 6px;
}

.flir-zoom-slider .unity-base-slider__dragger {
    background-color: rgb(0, 229, 255);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
    border-radius: 3px;
    width: 14px;
    height: 14px;
    margin-left: -4px;
}

.flir-zoom-slider .unity-base-slider__dragger:hover {
    background-color: rgb(255, 255, 255);
    border-color: rgb(0, 229, 255);
}

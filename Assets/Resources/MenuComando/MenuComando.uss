/* ============================================================
   MENU COMANDO TÁTICO — USS Theme
   Baseado no protótipo HTML/CSS tático com tema ciano escuro
   ============================================================ */

/* --- VARIÁVEIS GLOBAIS (via classes utilitárias) --- */
/* --primary: #00e5ff  --enemy: #ff3333  --alert: #ffaa00 */

/* --- ROOT --- */
.menu-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    display: flex;
    flex-direction: column;
    background-color: rgba(5, 9, 12, 0.0); /* Transparent to allow seeing the 3D map */
    padding: 12px;
}

/* --- OVERLAY CRT (scanlines) --- */
.crt-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* --- TIPOGRAFIA --- */
.mono {
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* --- HEADER --- */
.header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 229, 255, 0.3);
    padding-bottom: 8px;
    margin-bottom: 10px;
    height: 36px;
    flex-shrink: 0;
}

.header-titulo {
    color: rgb(0, 229, 255);
    font-size: 15px;
    -unity-font-style: bold;
}

.header-center {
    flex-direction: row;
    align-items: center;
}

.header-status {
    color: rgb(0, 229, 255);
    font-size: 11px;
    opacity: 0.8;
}

.header-tempo {
    color: rgb(107, 139, 153);
    font-size: 12px;
}

.menu-fechar {
    min-width: 86px;
    height: 28px;
    margin-right: 8px;
    align-self: center;
    border-width: 1px;
    border-color: rgb(0, 190, 220);
    background-color: rgb(10, 45, 60);
    color: rgb(230, 250, 255);
    font-size: 11px;
}

.menu-fechar:hover {
    background-color: rgb(20, 90, 110);
}

/* --- PAINEL BASE (rts-panel) --- */
.rts-panel {
    background-color: rgba(10, 16, 22, 0.88);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.3);
    border-radius: 3px;
    overflow: hidden;
    position: relative;
}

/* Brilho no topo via borda (USS não suporta ::before) */
.rts-panel {
    border-top-width: 1px;
    border-top-color: rgba(0, 229, 255, 0.5);
}

/* --- CORPO PRINCIPAL (Mapa + FLIR) --- */
.corpo-principal {
    flex-direction: row;
    margin-bottom: 10px;
    flex: 1;
    min-height: 0;
}

/* --- PAINEL DO MAPA --- */
.painel-mapa {
    flex: 1.3;
    position: relative;
    background-color: rgb(11, 20, 26);
    overflow: hidden;
}

.seguir-drawer {
    position: absolute;
    left: 10px;
    top: 42px;
    width: 270px;
    bottom: 10px;
    background-color: rgba(5, 10, 14, 0.94);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.35);
    border-radius: 4px;
    padding: 8px;
    display: none;
    flex-direction: column;
}

.seguir-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.seguir-fechar {
    width: 24px;
    height: 24px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.35);
    color: rgb(0, 229, 255);
    background-color: rgba(0, 0, 0, 0.35);
}

.seguir-fechar:hover {
    border-color: rgb(0, 229, 255);
}

.seguir-distancias {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
}

.seguir-dist-btn {
    width: 48%;
    height: 30px;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.35);
    border-radius: 2px;
    background-color: rgba(0, 32, 44, 0.7);
    color: rgb(0, 229, 255);
    font-size: 10px;
}

.seguir-dist-btn.ativo {
    background-color: rgba(0, 120, 160, 0.8);
    border-color: rgb(0, 229, 255);
    color: rgb(255, 255, 255);
}

.seguir-status {
    color: rgb(107, 139, 153);
    font-size: 9px;
    flex-shrink: 0;
    white-space: normal;
}

.seguir-scroll {
    flex: 1;
    min-height: 0;
}

.seguir-lista {
    flex-direction: column;
    padding-right: 2px;
}

.seguir-item {
    min-height: 36px;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.25);
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.35);
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 5px;
    padding-bottom: 5px;
    justify-content: center;
    transition-duration: 0.14s;
    transition-property: background-color, border-color, scale, translate;
}

.seguir-item:hover {
    border-color: rgb(0, 229, 255);
    background-color: rgba(0, 48, 64, 0.8);
}

.seguir-item.ativo {
    border-color: rgb(255, 220, 0);
    background-color: rgba(48, 42, 0, 0.9);
    scale: 1.02;
}

.seguir-item.seguir-item-pulse {
    border-color: rgb(255, 245, 120);
    background-color: rgba(86, 76, 0, 0.98);
    scale: 1.05;
    translate: 0 -1px;
}

.seguir-item-nome {
    color: rgb(0, 229, 255);
    font-size: 11px;
    -unity-font-style: bold;
}

.seguir-item-meta {
    color: rgb(180, 200, 210);
    font-size: 9px;
}

.panel-label {
    color: rgb(107, 139, 153);
    font-size: 11px;
    -unity-font-style: bold;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 229, 255, 0.2);
    padding: 5px 8px;
    letter-spacing: 2px;
    flex-shrink: 0;
}

/* Grade do mapa */
.mapa-grade {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* Radar sweep */
.radar-sweep {
    position: absolute;
    top: 50%; left: 50%;
    width: 200%;
    height: 2px;
    background-color: rgba(0, 229, 255, 0.4);
    transform-origin: left center;
    opacity: 0.35;
    /* Animação via C# (rotate) */
}

/* Layer das unidades */
.mapa-unidades-layer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.mapa-linhas-layer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* --- MARCADORES DE UNIDADE NO MAPA --- */
.mapa-unidade {
    position: absolute;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    /* offset para centralizar */
    margin-left: -21px;
    margin-top: -21px;
}

.mapa-unidade.contato-antigo {
    opacity: 0.52;
}

/* Imóveis civis: pontos discretos e sem barra de vida para não dominar o
   satélite. A seleção normal continua reservada às unidades controláveis;
   imóveis só viram alvo quando o modo ATAQUE está ativo. */
.mapa-unidade.imovel {
    width: 16px;
    height: 16px;
    margin-left: -8px;
    margin-top: -8px;
    opacity: 0.62;
}

.mapa-unidade.imovel.fazenda {
    opacity: 0.68;
}

.mapa-unidade.imovel .mapa-marcador {
    width: 8px;
    height: 8px;
    border-width: 1px;
    border-radius: 50%;
    font-size: 0;
    background-color: rgba(30, 50, 30, 0.58);
}

.mapa-unidade.imovel.residencia .mapa-marcador {
    background-color: rgba(70, 70, 70, 0.52);
}

.mapa-unidade.imovel .mapa-hp-track {
    display: none;
}

.mapa-unidade.imovel .mapa-sel-ring {
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    border-width: 1px;
}

.mapa-unidade.imovel .mapa-sel-ring.visivel {
    scale: 1.05 1.05;
}

.mapa-unidade.controlavel .mapa-marcador {
    border-color: rgb(255, 220, 0);
}

.mapa-marcador {
    width: 22px;
    height: 22px;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    background-color: rgba(0, 0, 0, 0.7);
    border-width: 2px;
    border-radius: 3px;
}

.mapa-marcador.amigo {
    border-color: rgb(0, 229, 255);
    color: rgb(0, 229, 255);
}

.mapa-marcador.inimigo {
    border-color: rgb(255, 51, 51);
    color: rgb(255, 51, 51);
    rotate: 45deg;
}

.mapa-marcador.destruido {
    border-color: rgb(85, 85, 85);
    color: rgb(85, 85, 85);
    opacity: 0.5;
}

.mapa-label {
    position: absolute;
    top: -18px;
    font-size: 9px;
    -unity-font-style: bold;
    white-space: nowrap;
    background-color: rgba(0, 0, 0, 0.85);
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-width: 1px;
}

.mapa-label.amigo {
    color: rgb(0, 229, 255);
    border-color: rgb(0, 229, 255);
}

.mapa-label.inimigo {
    color: rgb(255, 51, 51);
    border-color: rgb(255, 51, 51);
}

.mapa-label.selecionado {
    color: rgb(255, 255, 0);
    border-color: rgb(255, 255, 0);
}

.mapa-label.foco {
    color: rgb(255, 255, 255);
    border-color: rgb(255, 255, 255);
    background-color: rgba(255, 190, 0, 0.45);
}

/* Imóveis: presença no mapa sem texto grande e sem aglomerar rótulos. */
.mapa-label.imovel {
    width: 4px;
    height: 4px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 0;
    border-width: 0;
    border-radius: 50%;
    background-color: transparent;
    -unity-text-align: middle-center;
}

.mapa-marcador.selecionado {
    border-color: rgb(255, 225, 0);
    color: rgb(255, 225, 0);
    background-color: rgba(120, 90, 0, 0.72);
}

.mapa-marcador.foco {
    border-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    background-color: rgba(255, 170, 0, 0.78);
}

/* Mini barra de HP no mapa */
.mapa-hp-track {
    position: absolute;
    bottom: -6px;
    left: 0; right: 0;
    height: 3px;
    background-color: rgb(30, 30, 30);
}

.mapa-hp-fill {
    height: 100%;
}

.mapa-hp-fill.amigo { background-color: rgb(0, 229, 255); }
.mapa-hp-fill.inimigo { background-color: rgb(255, 51, 51); }

/* Anel de seleção */
.mapa-sel-ring {
    position: absolute;
    top: -4px; left: -4px; right: -4px; bottom: -4px;
    border-width: 2px;
    border-color: rgb(255, 220, 0);
    border-radius: 50%;
    opacity: 0;
}

.mapa-sel-ring.visivel {
    opacity: 1;
    border-width: 3px;
    scale: 1.12 1.12;
}

.ordem-selecionada {
    border-color: rgb(255, 224, 72);
    background-color: rgba(255, 190, 0, 0.38);
    color: rgb(255, 255, 255);
    scale: 1.03 1.03;
}

/* --- PAINEL FLIR --- */
.painel-flir {
    flex: 1;
    position: relative;
    background-color: rgb(10, 10, 10);
    overflow: hidden;
    border-color: rgba(100, 100, 100, 0.4);
}

/* Imagem da câmera (RenderTexture) */
.flir-imagem {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0.9;
}

/* Noise overlay */
.flir-noise {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* Crosshair */
.flir-crosshair {
    position: absolute;
    top: 50%; left: 50%;
    width: 140px; height: 140px;
    margin-left: -70px;
    margin-top: -70px;
}

.crosshair-h {
    position: absolute;
    top: 50%;
    left: -20px; right: -20px;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.75);
    margin-top: -0.5px;
}

.crosshair-v {
    position: absolute;
    left: 50%;
    top: -20px; bottom: -20px;
    width: 1px;
    background-color: rgba(255, 255, 255, 0.75);
    margin-left: -0.5px;
}

.crosshair-box {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.45);
}

/* Overlay de texto do FLIR */
.flir-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.flir-text {
    position: absolute;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.9);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.flir-tl { top: 10px; left: 10px; }
.flir-tc { top: 10px; left: 50%; translate: -50% 0; }
.flir-tr { top: 10px; right: 10px; }
.flir-bc { bottom: 22px; left: 50%; translate: -50% 0; color: rgb(255, 170, 0); }

.flir-unidade-nome {
    position: absolute;
    bottom: 8px;
    right: 10px;
    font-size: 10px;
    color: rgb(0, 229, 255);
}

.flir-alert {
    color: rgb(255, 170, 0);
}

/* --- ÁREA INFERIOR --- */
.area-inferior {
    flex-direction: row;
    height: 290px;
    flex-shrink: 0;
}

.painel-bottom {
    flex: 1;
    padding-top: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    overflow: hidden;
    flex-direction: column;
}

/* O painel de ordens tem cinco linhas com as acoes restantes. Mantemos
   espacamento compacto para que a ultima linha e o feedback nunca sejam
   cortados pela altura fixa da faixa inferior. */
.painel-ordens {
    padding-top: 6px;
    padding-bottom: 6px;
    flex-grow: 1.25;
}

/* --- TELEMETRIA DA UNIDADE --- */
.unidade-header {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    flex-shrink: 0;
}

.unidade-emoji {
    font-size: 20px;
}

.unidade-nome {
    color: rgb(0, 229, 255);
    font-size: 16px;
    -unity-font-style: bold;
    flex: 1;
}

.stat-grid {
    flex-direction: column;
    margin-top: 4px;
    flex-shrink: 0;
}

.stat-row {
    flex-direction: row;
    align-items: center;
}

.stat-lbl {
    color: rgb(107, 139, 153);
    font-size: 11px;
    width: 55px;
}

.stat-val {
    color: rgb(208, 232, 240);
    font-size: 11px;
    -unity-font-style: bold;
    flex: 1;
    padding-top: 3px;
    padding-bottom: 3px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.stat-armas-live {
    white-space: normal;
    font-size: 9px;
    padding-top: 1px;
    padding-bottom: 1px;
}

.stat-ok { color: rgb(0, 229, 255); }
.stat-alert { color: rgb(255, 170, 0); }
.stat-danger { color: rgb(255, 51, 51); }

.progress-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    height: 16px;
    flex-shrink: 0;
}

.progress-lbl {
    font-size: 10px;
    color: rgb(107, 139, 153);
    -unity-font-style: bold;
    width: 45px;
}

.progress-track {
    flex: 1;
    height: 8px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.2);
    margin-left: 6px;
    margin-right: 6px;
    border-radius: 2px;
}

.progress-fill {
    height: 100%;
}

.progress-val {
    font-size: 10px;
    color: rgb(208, 232, 240);
    -unity-font-style: bold;
    width: 35px;
    -unity-text-align: middle-right;
}

.hp-fill { background-color: rgb(0, 229, 255); }
.fuel-fill { background-color: rgb(243, 156, 18); }

/* --- SITREP --- */
.sitrep-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 0;
}

.sitrep-row .stat-lbl {
    width: 118px;
    font-size: 12px;
    color: rgb(146, 175, 186);
    -unity-font-style: bold;
}

.sitrep-separator {
    border-top-width: 1px;
    border-top-color: rgba(0, 229, 255, 0.15);
    margin-top: 4px;
    padding-top: 6px;
}

.sitrep-valor {
    color: rgb(245, 250, 255);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    background-color: rgba(0, 0, 0, 0.42);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.16);
    border-radius: 3px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 2px;
    padding-bottom: 2px;
    min-height: 20px;
}

.sitrep-aliados { color: rgb(0, 229, 255); font-size: 15px; }
.sitrep-inimigos { color: rgb(255, 51, 51); font-size: 15px; }
.sitrep-ameaca { color: rgb(255, 170, 0); font-size: 12px; }
.sitrep-fuel { color: rgb(255, 200, 120); }
.sitrep-vel { color: rgb(225, 238, 245); }
.sitrep-sel { color: rgb(220, 242, 248); }
.sitrep-tempo { color: rgb(210, 230, 238); }

/* --- LOG DE COMUNICAÇÕES --- */
.log-scroll {
    flex: 1;
    min-height: 0;
}

.log-scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical {
    width: 6px;
}

.log-scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical > .unity-base-slider__tracker {
    background-color: rgba(0,0,0,0.3);
}

.log-scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical > .unity-base-slider__dragger {
    background-color: rgba(0, 229, 255, 0.4);
    border-radius: 2px;
}

.log-container {
    flex-direction: column;
    padding-right: 4px;
}

.log-entry {
    flex-direction: column;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
    padding-bottom: 3px;
}

.log-linha {
    flex-direction: row;
    flex-wrap: wrap;
}

.log-time {
    color: rgb(107, 139, 153);
    font-size: 9px;
    margin-right: 4px;
}

.log-source {
    color: rgb(0, 229, 255);
    font-size: 9px;
    -unity-font-style: bold;
    margin-right: 4px;
}

.log-source.inimigo { color: rgb(255, 51, 51); }
.log-source.sistema { color: rgb(255, 170, 0); }

.log-msg {
    color: rgb(180, 200, 210);
    font-size: 9px;
}

/* --- ORDENS --- */
.ordens-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.painel-ordens .ordens-grid {
    margin-top: 3px;
    flex-direction: column;
    flex-wrap: nowrap;
    flex-grow: 1;
    min-height: 0;
}

.ordens-row {
    flex-direction: row;
    height: 30px;
    min-height: 30px;
    flex-shrink: 0;
}

.ordem-btn {
    flex: 1;
    min-width: 45%;
    height: 34px;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.4);
    border-radius: 2px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    transition-duration: 0.15s;
    transition-property: background-color, border-color;
}

.painel-ordens .ordem-btn {
    height: 30px;
    min-height: 30px;
    width: auto;
    max-width: none;
    flex-basis: auto;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.ordem-btn:hover {
    border-width: 1px;
}

.btn-ativo {
    background-color: rgba(180, 0, 0, 0.35);
    color: rgb(255, 100, 100);
    border-color: rgba(255, 51, 51, 0.6);
}
.btn-ativo:hover {
    background-color: rgba(200, 20, 20, 0.55);
    border-color: rgb(255, 51, 51);
}

.btn-passivo {
    background-color: rgba(0, 80, 180, 0.35);
    color: rgb(100, 180, 255);
    border-color: rgba(0, 150, 255, 0.5);
}
.btn-passivo:hover {
    background-color: rgba(0, 100, 200, 0.55);
    border-color: rgb(0, 229, 255);
}

.btn-estado {
    background-color: rgba(0, 130, 150, 0.35);
    color: rgb(120, 245, 245);
    border-color: rgba(0, 220, 220, 0.65);
}
.btn-estado:hover {
    background-color: rgba(0, 170, 180, 0.55);
    border-color: rgb(0, 255, 255);
}

.btn-lancar-missil {
    background-color: rgba(170, 45, 15, 0.42);
    color: rgb(255, 190, 100);
    border-color: rgba(255, 125, 35, 0.75);
}
.btn-lancar-missil:hover {
    background-color: rgba(220, 65, 20, 0.62);
    border-color: rgb(255, 210, 120);
}

.btn-patrulhar {
    background-color: rgba(160, 80, 0, 0.35);
    color: rgb(255, 170, 80);
    border-color: rgba(255, 130, 0, 0.5);
}
.btn-patrulhar:hover {
    background-color: rgba(180, 100, 0, 0.55);
    border-color: rgb(255, 170, 0);
}

.btn-mover {
    background-color: rgba(0, 125, 120, 0.38);
    color: rgb(100, 245, 220);
    border-color: rgba(0, 220, 190, 0.65);
}
.btn-mover:hover {
    background-color: rgba(0, 165, 150, 0.58);
    border-color: rgb(120, 255, 230);
}

.btn-seguir {
    background-color: rgba(100, 0, 140, 0.35);
    color: rgb(200, 120, 255);
    border-color: rgba(160, 50, 200, 0.5);
}
.btn-seguir:hover {
    background-color: rgba(130, 20, 170, 0.55);
    border-color: rgb(200, 80, 255);
}

.btn-atacar {
    background-color: rgba(220, 20, 60, 0.35);
    color: rgb(255, 80, 100);
    border-color: rgba(255, 30, 80, 0.5);
}
.btn-atacar:hover {
    background-color: rgba(255, 30, 80, 0.55);
    border-color: rgb(255, 50, 100);
}

.ordens-status {
    margin-top: 6px;
    padding-top: 8px;
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    flex-shrink: 0;
}

.radar-mini {
    width: 25px;
    min-width: 25px;
    max-width: 25px;
    height: 30px;
    min-height: 30px;
    flex-grow: 0;
    flex-shrink: 0;
    padding-left: 0;
    padding-right: 0;
    background-color: rgba(205, 93, 0, 0.32);
    color: rgb(255, 167, 64);
    border-color: rgba(255, 145, 35, 0.78);
    border-width: 1px;
    -unity-font-style: bold;
}

.radar-mini:hover {
    background-color: rgba(235, 111, 0, 0.58);
    border-color: rgb(255, 184, 75);
}

.radar-mini.radar-ligado {
    background-color: rgba(255, 116, 0, 0.68);
    color: rgb(255, 225, 170);
    border-color: rgb(255, 155, 45);
    border-width: 2px;
}

.radar-mini.radar-sem-energia {
    background-color: rgba(155, 48, 0, 0.6);
    color: rgb(255, 115, 75);
    border-color: rgb(235, 75, 35);
}

.ordem-feedback {
    flex-grow: 1;
    color: rgb(107, 139, 153);
    font-size: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* --- BLINK ANIMATION (via opacity) --- */
.blink {
    opacity: 1;
    /* Animado via C# toggling opacity */
}

/* --- BOTÃO SELECIONAR TUDO (FLUTUANTE NO MAPA) --- */
.mapa-selecao-barra {
    position: absolute;
    width: 570px;
    height: 22px;
    left: 480px;
    top: 42px;
    flex-direction: row;
    align-items: center;
}

.btn-selecionar-tudo {
    position: relative;
    width: 115px;
    height: 18px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(5, 9, 12, 0.85);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.4);
    border-radius: 2px;
    color: rgb(0, 229, 255);
    font-size: 8px;
    transition-duration: 0.12s;
    transition-property: background-color;
}

.btn-selecionar-tudo:hover {
    background-color: rgba(0, 229, 255, 0.25);
    border-color: rgb(0, 229, 255);
}

.btn-desselecionar-tudo {
    position: relative;
    width: 142px;
    margin-left: 4px;
    height: 18px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(35, 8, 8, 0.9);
    border-width: 1px;
    border-color: rgba(255, 90, 90, 0.55);
    border-radius: 2px;
    color: rgb(255, 150, 150);
    font-size: 8px;
}

.btn-desselecionar-tudo:hover {
    background-color: rgba(255, 60, 60, 0.25);
    border-color: rgb(255, 90, 90);
    color: rgb(255, 220, 220);
}

.selecao-resumo {
    position: relative;
    flex-grow: 1;
    min-width: 80px;
    margin-left: 4px;
    height: 18px;
    overflow: hidden;
    white-space: nowrap;
    color: rgb(255, 230, 70);
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

/* --- ZOOM SLIDER --- */
.flir-zoom-slider {
    position: absolute;
    top: 40px;
    bottom: 50px;
    right: 15px;
    width: 20px;
}

.flir-zoom-slider .unity-base-slider__tracker {
    background-color: rgba(0, 50, 70, 0.6);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.4);
    border-radius: 3px;
    width: 6px;
}

.flir-zoom-slider .unity-base-slider__dragger {
    background-color: rgb(0, 229, 255);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
    border-radius: 3px;
    width: 14px;
    height: 14px;
    margin-left: -4px;
}

.flir-zoom-slider .unity-base-slider__dragger:hover {
    background-color: rgb(255, 255, 255);
    border-color: rgb(0, 229, 255);
}

/* Barra de comando contextual persistente */
.menu-command-host {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.barra-comando-contextual {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    min-height: 82px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(4, 12, 17, 0.96);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 2px;
    border-left-width: 1px;
    border-top-color: rgba(0, 229, 255, 0.48);
    border-right-color: rgba(0, 229, 255, 0.28);
    border-bottom-color: rgba(0, 229, 255, 0.72);
    border-left-color: rgba(0, 229, 255, 0.28);
}

.contexto-unidade {
    flex-direction: column;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 170px;
    max-width: 310px;
    margin-right: 10px;
}

.contexto-tipo {
    color: rgb(0, 229, 255);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.contexto-unidade-nome {
    color: rgb(245, 250, 255);
    font-size: 13px;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.contexto-detalhes {
    color: rgb(150, 180, 190);
    font-size: 9px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.contexto-acoes {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
}

.contexto-botao {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 58px;
    height: 42px;
    margin-left: 3px;
    padding-left: 3px;
    padding-right: 3px;
    background-color: rgba(0, 90, 110, 0.3);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(0, 229, 255, 0.28);
    border-right-color: rgba(0, 229, 255, 0.28);
    border-bottom-color: rgba(0, 229, 255, 0.42);
    border-left-color: rgba(0, 229, 255, 0.28);
    color: rgb(190, 235, 245);
    font-size: 9px;
    -unity-font-style: bold;
}

.contexto-botao:hover {
    background-color: rgba(0, 170, 190, 0.45);
    border-top-color: rgb(0, 229, 255);
    border-right-color: rgb(0, 229, 255);
    border-bottom-color: rgb(0, 229, 255);
    border-left-color: rgb(0, 229, 255);
    color: rgb(255, 255, 255);
}

.contexto-botao:disabled {
    opacity: 0.38;
}

.contexto-mover { color: rgb(100, 245, 220); }
.contexto-patrulha { color: rgb(255, 190, 90); }
.contexto-atacar { color: rgb(255, 115, 125); }
.contexto-seguir { color: rgb(210, 150, 255); }
.contexto-radar { color: rgb(255, 180, 90); }
.contexto-ativo { color: rgb(255, 130, 130); }
.contexto-passivo { color: rgb(130, 195, 255); }
.contexto-base { color: rgb(200, 225, 150); }
.contexto-centro { color: rgb(0, 229, 255); }

.contexto-feedback {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 90px;
    max-width: 190px;
    margin-left: 8px;
    color: rgb(255, 210, 100);
    font-size: 9px;
    -unity-text-align: middle-right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* HUD tático modular persistente: rodapé compacto responsivo */
.barra-comando-contextual {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 0;
    height: 96px;
    max-height: 96px;
    min-height: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    flex-direction: column;
    align-items: stretch;
    background-color: rgba(7, 17, 26, 0.96);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 0;
    border-left-width: 1px;
    border-top-color: rgba(62, 113, 136, 0.88);
    border-right-color: rgba(62, 113, 136, 0.78);
    border-left-color: rgba(62, 113, 136, 0.78);
}

.contexto-modulos {
    height: 76%;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    min-height: 0;
    align-items: stretch;
}

.tactical-card {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    min-width: 0;
    margin-right: 3px;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 3px;
    padding-left: 4px;
    flex-direction: column;
    overflow: hidden;
    background-color: rgba(11, 25, 36, 0.97);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(62, 113, 136, 0.78);
    border-right-color: rgba(62, 113, 136, 0.78);
    border-bottom-color: rgba(62, 113, 136, 0.78);
    border-left-color: rgba(62, 113, 136, 0.78);
}
.identity-card { flex-grow: 1.45; }
.speed-card { flex-grow: 0.9; }
.condition-card { flex-grow: 0.9; }
.formation-card { flex-grow: 0.9; }
.roe-card { flex-grow: 0.9; }
.sensors-card { flex-grow: 1; }
.weapons-card { flex-grow: 1.2; }
.counter-card { flex-grow: 0.95; }
.waypoint-card { flex-grow: 1.15; }
.automation-card { flex-grow: 0.8; margin-right: 0; }
.tactical-card:hover {
    background-color: rgba(16, 34, 48, 0.99);
    border-top-color: rgb(107, 167, 189);
    border-right-color: rgb(107, 167, 189);
    border-bottom-color: rgb(107, 167, 189);
    border-left-color: rgb(107, 167, 189);
}

.identity-heading {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    min-height: 16px;
}
.country-flag {
    width: 24px;
    min-width: 24px;
    height: 15px;
    margin-right: 4px;
    flex-direction: column;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(143, 165, 178, 0.65);
    border-right-color: rgba(143, 165, 178, 0.65);
    border-bottom-color: rgba(143, 165, 178, 0.65);
    border-left-color: rgba(143, 165, 178, 0.65);
}
.flag-stripe { flex-grow: 1; min-height: 0; }
.identity-titles { flex-direction: column; min-width: 0; flex-grow: 1; }
.identity-info {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    align-items: center;
    overflow: hidden;
}
.identity-meters { flex-direction: column; flex-grow: 1; min-width: 0; }
.unit-preview {
    width: 32px;
    height: 24px;
    max-height: 35%;
    min-height: 0;
    flex-shrink: 0;
    margin-right: 5px;
    overflow: hidden;
    -unity-background-scale-mode: scale-to-fit;
}
.unit-preview-photo { background-color: rgba(5, 12, 18, 0.9); }
.vital-row { height: 12px; flex-shrink: 0; flex-direction: row; align-items: center; min-width: 0; }
.card-title {
    color: rgb(145, 181, 198);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 0.35px;
    margin-bottom: 2px;
    flex-shrink: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.identity-name {
    color: rgb(230, 239, 244);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.status-green { color: rgb(36, 221, 138); font-size: 10px; -unity-font-style: bold; }
.card-copy {
    color: rgb(143, 165, 178);
    font-size: 10px;
    margin-top: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.card-value {
    color: rgb(218, 232, 239);
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 0;
    margin-bottom: 1px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.meter { height: 3px; flex-grow: 1; min-width: 8px; margin-left: 4px; background-color: rgba(76, 105, 119, 0.35); }
.meter-fill { height: 100%; width: 0%; }
.green-fill { background-color: rgb(36, 221, 138); }
.cyan-fill { background-color: rgb(25, 189, 235); }
.hud-warning { background-color: rgb(241, 181, 41); }
.hud-critical { background-color: rgb(215, 80, 75); }
.status-warning { color: rgb(241, 181, 41); }
.status-critical { color: rgb(215, 80, 75); }

.compass {
    width: 30px;
    height: 30px;
    min-height: 0;
    flex-grow: 1;
    margin-top: 1px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(62, 113, 136, 0.75);
    border-right-color: rgba(62, 113, 136, 0.75);
    border-bottom-color: rgba(62, 113, 136, 0.75);
    border-left-color: rgba(62, 113, 136, 0.75);
}
.compass-n,.compass-s { position: absolute; color: rgb(143, 165, 178); font-size: 7px; }
.compass-n { top: 1px; }
.compass-s { bottom: 1px; }
.compass-arrow { color: rgb(25, 189, 235); font-size: 16px; }
.formation-widget {
    flex-grow: 1;
    min-height: 0;
    max-height: 34px;
    position: relative;
    align-items: center;
    justify-content: center;
}
.formation-slot {
    position: absolute;
    width: 16px;
    height: 16px;
    min-height: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    color: rgb(193, 216, 226);
    background-color: rgba(17, 39, 53, 0.95);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(62, 113, 136);
    border-right-color: rgb(62, 113, 136);
    border-bottom-color: rgb(62, 113, 136);
    border-left-color: rgb(62, 113, 136);
    border-radius: 8px;
    font-size: 9px;
}
.formation-editing { border-top-color: rgb(25, 189, 235); border-right-color: rgb(25, 189, 235); border-bottom-color: rgb(25, 189, 235); border-left-color: rgb(25, 189, 235); background-color: rgba(25, 189, 235, 0.10); }
.formation-editing .formation-slot:hover { border-top-color: rgb(25, 189, 235); border-right-color: rgb(25, 189, 235); border-bottom-color: rgb(25, 189, 235); border-left-color: rgb(25, 189, 235); background-color: rgba(25, 189, 235, 0.28); }
#formation-slot-1 { left: 50%; top: 50%; margin-left: -8px; margin-top: -8px; }
#formation-slot-2 { left: 50%; top: 0; margin-left: -8px; }
#formation-slot-3 { left: 1px; top: 50%; margin-top: -8px; }
#formation-slot-4 { right: 1px; top: 50%; margin-top: -8px; }
#formation-slot-5 { left: 50%; bottom: 0; margin-left: -8px; }
.formation-leader { color: rgb(7, 17, 26); background-color: rgb(25, 189, 235); border-top-color: rgb(107, 167, 189); border-right-color: rgb(107, 167, 189); border-bottom-color: rgb(107, 167, 189); border-left-color: rgb(107, 167, 189); }
.roe-option,.system-row {
    min-height: 10px;
    height: 10px;
    margin-top: 1px;
    padding-top: 0;
    padding-right: 2px;
    padding-bottom: 0;
    padding-left: 2px;
    color: rgb(193, 216, 226);
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 9px;
    -unity-text-align: middle-left;
    overflow: hidden;
}
.roe-option:hover,.system-row:hover { background-color: rgba(25, 189, 235, 0.12); }
.roe-selected { color: rgb(241, 181, 41); background-color: rgba(241, 181, 41, 0.12); }
.unavailable { color: rgb(97, 113, 122); }
.waypoint-graphic {
    height: 22px;
    min-height: 0;
    flex-grow: 1;
    margin-top: 1px;
    color: rgb(25, 189, 235);
    font-size: 12px;
    -unity-text-align: middle-center;
    overflow: hidden;
}
.mini-action {
    height: 16px;
    min-height: 16px;
    color: rgb(25, 189, 235);
    background-color: rgba(25, 189, 235, 0.12);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(25, 189, 235, 0.38);
    border-right-color: rgba(25, 189, 235, 0.38);
    border-bottom-color: rgba(25, 189, 235, 0.38);
    border-left-color: rgba(25, 189, 235, 0.38);
    font-size: 8px;
}

.contexto-quick-row {
    height: 24%;
    min-height: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: stretch;
    margin-top: 0;
    padding-top: 1px;
    padding-right: 2px;
    padding-bottom: 1px;
    padding-left: 2px;
    background-color: rgba(11, 25, 36, 0.98);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(62, 113, 136, 0.78);
    border-right-color: rgba(62, 113, 136, 0.78);
    border-bottom-color: rgba(62, 113, 136, 0.78);
    border-left-color: rgba(62, 113, 136, 0.78);
}
.quick-action {
    height: 100%;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 3px;
    padding-top: 0;
    padding-right: 2px;
    padding-bottom: 0;
    padding-left: 2px;
    color: rgb(193, 216, 226);
    background-color: rgba(16, 34, 48, 0.95);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(62, 113, 136, 0.48);
    border-right-color: rgba(62, 113, 136, 0.48);
    border-bottom-color: rgba(62, 113, 136, 0.48);
    border-left-color: rgba(62, 113, 136, 0.48);
    font-size: 9px;
    -unity-font-style: bold;
}
.quick-action:hover,.utility-action:hover {
    color: rgb(25, 189, 235);
    border-top-color: rgb(25, 189, 235);
    border-right-color: rgb(25, 189, 235);
    border-bottom-color: rgb(25, 189, 235);
    border-left-color: rgb(25, 189, 235);
    background-color: rgba(25, 189, 235, 0.13);
}
.utility-action {
    width: 27px;
    min-width: 27px;
    height: 100%;
    min-height: 0;
    margin-left: 2px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    color: rgb(143, 181, 198);
    background-color: rgba(16, 34, 48, 0.95);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(62, 113, 136, 0.48);
    border-right-color: rgba(62, 113, 136, 0.48);
    border-bottom-color: rgba(62, 113, 136, 0.48);
    border-left-color: rgba(62, 113, 136, 0.48);
    font-size: 14px;
}
.hud-close-button { width: 23px; min-width: 23px; font-size: 16px; }
.quick-action:hover,.utility-action:hover { color: rgb(25, 189, 235); }
.contexto-feedback {
    position: absolute;
    right: 6px;
    top: 3px;
    max-width: 30%;
    min-width: 0;
    background-color: rgba(7, 17, 26, 0.9);
    color: rgb(241, 181, 41);
    font-size: 8px;
}

.hud-dock-reabrir {
    position: absolute;
    right: 8px;
    bottom: 8px;
    width: 130px;
    height: 28px;
    display: none;
    align-items: stretch;
}
.hud-restore-button {
    width: 100%;
    height: 100%;
    min-height: 0;
    padding-top: 0;
    padding-right: 6px;
    padding-bottom: 0;
    padding-left: 6px;
    color: rgb(25, 189, 235);
    background-color: rgba(7, 17, 26, 0.96);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(25, 189, 235, 0.65);
    border-right-color: rgba(25, 189, 235, 0.65);
    border-bottom-color: rgba(25, 189, 235, 0.65);
    border-left-color: rgba(25, 189, 235, 0.65);
    font-size: 9px;
    -unity-font-style: bold;
}
.hud-restore-button:hover {
    color: white;
    background-color: rgba(16, 50, 67, 0.98);
}
.barra-comando-contextual.hud-small-resolution .tactical-card {
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 1px;
    padding-left: 2px;
}
.barra-comando-contextual.hud-small-resolution .card-title { font-size: 8px; }
.barra-comando-contextual.hud-small-resolution .identity-name { font-size: 11px; }
.barra-comando-contextual.hud-small-resolution .card-copy,
.barra-comando-contextual.hud-small-resolution .status-green { font-size: 9px; }
.barra-comando-contextual.hud-small-resolution .card-value { font-size: 12px; }
.barra-comando-contextual.hud-small-resolution .roe-option,
.barra-comando-contextual.hud-small-resolution .system-row,
.barra-comando-contextual.hud-small-resolution .quick-action { font-size: 8px; }
.barra-comando-contextual.hud-small-resolution .formation-widget { max-height: 25px; }
.barra-comando-contextual.hud-small-resolution .formation-slot { width: 13px; height: 13px; border-radius: 7px; font-size: 7px; }
.barra-comando-contextual.hud-small-resolution #formation-slot-1 { margin-left: -6px; margin-top: -6px; }
.barra-comando-contextual.hud-small-resolution #formation-slot-2 { margin-left: -6px; }
.barra-comando-contextual.hud-small-resolution #formation-slot-3 { margin-top: -6px; }
.barra-comando-contextual.hud-small-resolution #formation-slot-4 { margin-top: -6px; }
.barra-comando-contextual.hud-small-resolution #formation-slot-5 { margin-left: -6px; }
.barra-comando-contextual.hud-small-resolution .compass { width: 24px; height: 24px; }
.barra-comando-contextual.hud-small-resolution .unit-preview { width: 26px; height: 20px; }

.hud-card-overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    align-items: stretch;
    justify-content: center;
}
.hud-card-backdrop {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(2, 8, 13, 0.78);
}
.hud-card-detail-panel {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 8px;
    bottom: 8px;
    max-width: 1280px;
    padding: 14px;
    flex-direction: column;
    background-color: rgba(7, 17, 26, 0.99);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(25, 189, 235);
    border-right-color: rgba(62, 113, 136, 0.88);
    border-bottom-color: rgba(62, 113, 136, 0.88);
    border-left-color: rgba(62, 113, 136, 0.88);
}
.hud-card-detail-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}
.hud-card-detail-title {
    flex-grow: 1;
    color: rgb(25, 189, 235);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}
.hud-card-detail-close {
    width: 36px;
    min-width: 36px;
    height: 34px;
    min-height: 34px;
    margin-left: 12px;
    color: rgb(218, 232, 239);
    background-color: rgba(16, 34, 48, 0.95);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(62, 113, 136, 0.78);
    border-right-color: rgba(62, 113, 136, 0.78);
    border-bottom-color: rgba(62, 113, 136, 0.78);
    border-left-color: rgba(62, 113, 136, 0.78);
    font-size: 20px;
}
.hud-card-detail-close:hover {
    color: white;
    background-color: rgba(25, 189, 235, 0.2);
}
.hud-card-detail-description {
    margin-bottom: 10px;
    color: rgb(193, 216, 226);
    font-size: 14px;
    white-space: normal;
    overflow: visible;
}
.hud-card-detail-scroll {
    flex-grow: 1;
    min-height: 0;
}
.hud-card-detail-scroll .tactical-card {
    width: 100%;
    min-height: 220px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    margin-right: 0;
    padding: 14px;
    overflow: visible;
}
.hud-card-detail-scroll .hud-card-expanded-content > .card-title { display: none; }
.speed-card .hud-speed-controls { display: none; }
.hud-card-detail-scroll .speed-card .hud-speed-controls {
    display: flex;
    min-height: 52px;
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    padding: 6px;
    background-color: rgba(5, 15, 23, 0.9);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(62, 113, 136, 0.78);
    border-right-color: rgba(62, 113, 136, 0.78);
    border-bottom-color: rgba(62, 113, 136, 0.78);
    border-left-color: rgba(62, 113, 136, 0.78);
}
.hud-speed-adjust {
    min-width: 100px;
    min-height: 40px;
    flex-grow: 1;
    margin-right: 8px;
    margin-left: 8px;
    color: rgb(218, 232, 239);
    background-color: rgba(14, 37, 51, 0.98);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(62, 150, 181, 0.9);
    border-right-color: rgba(62, 150, 181, 0.9);
    border-bottom-color: rgba(62, 150, 181, 0.9);
    border-left-color: rgba(62, 150, 181, 0.9);
    font-size: 16px;
}
.hud-speed-adjust:hover {
    color: white;
    background-color: rgba(20, 91, 119, 0.98);
}
.hud-speed-order {
    min-width: 150px;
    color: rgb(31, 220, 151);
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
}
.hud-card-detail-scroll .tactical-card > .card-title {
    font-size: 15px;
    margin-bottom: 10px;
    white-space: normal;
    overflow: visible;
}
.hud-card-detail-scroll .identity-name {
    font-size: 19px;
    white-space: normal;
}
.hud-card-detail-scroll .card-copy {
    font-size: 13px;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
}
.hud-card-detail-scroll .status-green { font-size: 15px; }
.hud-card-detail-scroll .card-value { font-size: 20px; }
.hud-card-detail-scroll .identity-heading { min-height: 42px; }
.hud-card-detail-scroll .identity-info { min-height: 110px; }
.hud-card-detail-scroll .vital-row { height: 30px; }
.hud-card-detail-scroll .unit-preview { width: 92px; height: 68px; max-height: none; margin-right: 14px; }
.hud-card-detail-scroll .meter { height: 7px; }
.hud-card-detail-scroll .compass { width: 90px; height: 90px; flex-grow: 0; margin-top: 8px; }
.hud-card-detail-scroll .compass-n,
.hud-card-detail-scroll .compass-s { font-size: 12px; }
.hud-card-detail-scroll .compass-arrow { font-size: 38px; }
.hud-card-detail-scroll .formation-widget { min-height: 150px; max-height: 150px; flex-grow: 0; }
.hud-card-detail-scroll .formation-slot { width: 44px; height: 44px; border-radius: 22px; font-size: 16px; }
.hud-card-detail-scroll #formation-slot-1 { margin-left: -22px; margin-top: -22px; }
.hud-card-detail-scroll #formation-slot-2 { margin-left: -22px; }
.hud-card-detail-scroll #formation-slot-3 { margin-top: -22px; }
.hud-card-detail-scroll #formation-slot-4 { margin-top: -22px; }
.hud-card-detail-scroll #formation-slot-5 { margin-left: -22px; }
.hud-card-detail-scroll .roe-option,
.hud-card-detail-scroll .system-row {
    height: 38px;
    min-height: 38px;
    margin-top: 4px;
    padding: 4px 8px;
    font-size: 14px;
    white-space: normal;
    overflow: visible;
}
.hud-card-detail-scroll .mini-action {
    height: 38px;
    min-height: 38px;
    font-size: 14px;
}
.hud-card-detail-scroll .waypoint-graphic { height: 120px; font-size: 18px; }
/* Spacing fallbacks: UI Toolkit USS does not support CSS gap. */
.menu-root > .header { margin-bottom: 10px; }
.menu-root > .corpo-principal { margin-bottom: 10px; }
.corpo-principal > .painel-flir { margin-left: 10px; }
.seguir-drawer > .seguir-header,
.seguir-drawer > .seguir-distancias,
.seguir-drawer > .seguir-status { margin-bottom: 6px; }
.seguir-dist-btn { width: 47%; margin-right: 3px; margin-bottom: 5px; }
.seguir-lista > .seguir-item { margin-bottom: 5px; }
#painel-telemetria,
#painel-sitrep,
#painel-log { margin-right: 10px; }
.painel-bottom > .panel-label { margin-bottom: 5px; }
.unidade-header > .unidade-emoji { margin-right: 8px; }
.stat-grid > .stat-row { margin-bottom: 2px; }
.log-container > .log-entry { margin-bottom: 4px; }
.ordens-grid > .ordens-row { margin-bottom: 3px; }
.ordens-row > .ordem-btn { margin-right: 3px; }
.ordens-row > .radar-mini { margin-left: 3px; }

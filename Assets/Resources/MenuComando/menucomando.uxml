<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/MenuComando/menucomando.uss" />
    <ui:VisualElement name="root-container" class="milsim-root" style="display: none;">
        
        <!-- TOP AREA: CAMERAS -->
        <ui:VisualElement class="milsim-top-area">
            <!-- TACTICAL MAP -->
            <ui:VisualElement class="milsim-map-view">
                <ui:VisualElement name="map-viewport" class="milsim-viewport">
                    <ui:VisualElement name="map-overlay" class="milsim-map-overlay" />
                </ui:VisualElement>
                <ui:VisualElement class="flex-row" style="background-color: rgba(0,0,0,0.7); padding: 3px 4px; border-top-width: 1px; border-top-color: #162416;">
                    <ui:Button text="MAP" class="milsim-btn active" style="flex-grow: 1;" />
                    <ui:Button text="ICONS" class="milsim-btn" style="flex-grow: 1;" />
                    <ui:Button text="CAM" class="milsim-btn" style="flex-grow: 1;" />
                    <ui:Button text="INFO" class="milsim-btn" style="flex-grow: 1;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- UNIT PREVIEW 3D -->
            <ui:VisualElement class="milsim-3d-view">
                <ui:VisualElement name="camera-viewport" class="milsim-viewport" />
                <ui:Label text="NO SIGNAL / DISCONNECTED" name="lbl-no-signal" style="position: absolute; color: #f59e0b; -unity-font-style: bold; left: 0; right: 0; top: 100px; -unity-text-align: middle-center; display: none;" />
                <ui:VisualElement style="position: absolute; right: 8px; top: 8px; flex-direction: row;">
                    <ui:Button name="btn-follow" text="FOCAR CÂMERA" class="milsim-btn" style="background-color: rgba(0,0,0,0.4); border-color: rgba(100,120,100,0.4);" />
                    <ui:Button name="btn-stop" text="PARAR" class="milsim-btn" style="background-color: rgba(0,0,0,0.4); border-color: rgba(100,120,100,0.4);" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- BOTTOM PANEL -->
        <ui:VisualElement class="milsim-bottom-panel">
            
            <!-- UNIT INFO -->
            <ui:VisualElement class="milsim-col col-unit">
                <ui:VisualElement class="flex-row" style="align-items: center; margin-bottom: 4px;">
                    <ui:VisualElement style="width: 28px; margin-right: 8px;">
                        <ui:VisualElement style="height: 6px; background-color: #3b82f6;" />
                        <ui:VisualElement style="height: 6px; background-color: #ffffff;" />
                        <ui:VisualElement style="height: 6px; background-color: #3b82f6;" />
                    </ui:VisualElement>
                    <ui:Label name="lbl-unit-name" text="NENHUMA UNIDADE" class="txt-bright" style="font-size: 15px; -unity-font-style: bold; letter-spacing: 2px;" />
                </ui:VisualElement>
                <ui:VisualElement class="flex-row" style="align-items: center; margin-bottom: 4px;">
                    <ui:Label text="✈" style="font-size: 14px; opacity: 0.8; color: #90b870;" />
                    <ui:Label name="lbl-unit-type" text="—" class="txt-normal" style="font-size: 11px; margin-left: 5px;" />
                </ui:VisualElement>
                <ui:Label name="lbl-unit-speed-alt" text="Speed 0 km/h    Altitude 0 m" class="txt-muted" style="font-size: 11px; margin-top: 2px;" />
                <ui:Label name="lbl-unit-fuel-hp" text="Fuel -    Health -" class="txt-muted" style="font-size: 11px; margin-top: 2px;" />
                <ui:Label name="lbl-unit-target" text="⊙ No target" class="txt-dim" style="font-size: 10px; margin-top: auto; margin-bottom: 5px;" />
            </ui:VisualElement>

            <!-- SPEED & ALTITUDE -->
            <ui:VisualElement class="milsim-col col-speed-alt">
                <ui:Label text="SPEED" class="txt-label" />
                <ui:VisualElement class="flex-row" style="margin-bottom: 10px;">
                    <ui:Button name="btn-speed-min" text="MIN" class="milsim-btn" style="margin-right: 4px;" />
                    <ui:Button name="btn-speed-cruise" text="CRUISE" class="milsim-btn active" style="margin-right: 4px;" />
                    <ui:Button name="btn-speed-max" text="MAX" class="milsim-btn" />
                </ui:VisualElement>
                <ui:Label text="ALTITUDE" class="txt-label" />
                <ui:VisualElement class="flex-row">
                    <ui:Button name="btn-alt-1" text="100M" class="milsim-btn" style="margin-right: 3px;" />
                    <ui:Button name="btn-alt-2" text="900M" class="milsim-btn" style="margin-right: 3px;" />
                    <ui:Button name="btn-alt-3" text="3100M" class="milsim-btn active" style="margin-right: 3px;" />
                    <ui:Button name="btn-alt-4" text="6200M" class="milsim-btn" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- RULES OF ENGAGEMENT -->
            <ui:VisualElement class="milsim-col col-roe">
                <ui:Label text="RULES OF ENGAGEMENT" class="txt-label" style="margin-bottom: 8px;" />
                <ui:VisualElement class="roe-row">
                    <ui:Label text="AIR TARGETS" class="roe-label" />
                    <ui:Button name="btn-roe-air" text="▾ Do Not Engage" class="roe-dropdown-btn" />
                </ui:VisualElement>
                <ui:VisualElement class="roe-row">
                    <ui:Label text="LAND TARGETS" class="roe-label" />
                    <ui:Button name="btn-roe-land" text="▾ Do Not Engage" class="roe-dropdown-btn" />
                </ui:VisualElement>
                <ui:VisualElement class="roe-row">
                    <ui:Label text="SEA TARGETS" class="roe-label" />
                    <ui:Button name="btn-roe-sea" text="▾ Do Not Engage" class="roe-dropdown-btn" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- WEAPONS AND SENSORS -->
            <ui:VisualElement class="milsim-col col-weapons">
                <ui:Label text="WEAPONS AND SENSORS" class="txt-label" style="margin-bottom: 10px;" />
                <ui:VisualElement class="flex-row" style="align-items: flex-start;">
                    <ui:Label text="AN/APY-2 Radar&#10;(range 400 km)" class="txt-normal" style="font-size: 10px; flex-grow: 1;" />
                    <ui:VisualElement class="flex-row">
                        <ui:Button name="btn-radar-on" text="ON" class="milsim-btn radar-on" />
                        <ui:Button name="btn-radar-off" text="OFF" class="milsim-btn radar-off" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- COMMUNICATIONS -->
            <ui:VisualElement class="milsim-col col-comms">
                <ui:Label text="COMMUNICATION" class="txt-label" />
                <ui:ScrollView class="comms-scroll">
                    <ui:VisualElement class="flex-row comms-entry">
                        <ui:Label text="[SISTEMA]" class="comms-time" style="margin-right: 4px;" />
                        <ui:Label text="HQ:" class="comms-unit" style="margin-right: 4px;" />
                        <ui:Label text="Inicializando Interface Tática..." class="comms-msg" />
                    </ui:VisualElement>
                    <ui:VisualElement class="flex-row comms-entry">
                        <ui:Label text="[SISTEMA]" class="comms-time" style="margin-right: 4px;" />
                        <ui:Label text="HQ:" class="comms-unit" style="margin-right: 4px;" />
                        <ui:Label text="Aguardando Ordens." class="comms-msg" />
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:VisualElement class="bottom-actions">
                    <ui:Button name="btn-info" text="INFORMATION" class="milsim-btn" />
                    <ui:Button name="btn-close" text="CLOSE/MENU" class="milsim-btn" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

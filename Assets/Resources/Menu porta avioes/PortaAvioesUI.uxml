<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="PortaAvioesUI.uss" />

    <!-- Container base (Tela Inteira) — picking-mode=Ignore para não bloquear cliques fora do painel -->
    <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; top: 0; left: 0;">

        <!-- PAINEL LATERAL ESQUERDO (Porta-Aviões) — começa abaixo do HUD fixo do topo (~34px) -->
        <ui:VisualElement class="carrier-panel" name="carrierPanel">
            <ui:VisualElement class="header">
                <ui:Label class="gov-seal" text="DEPT. OF DEFENSE // NAVAL COMMAND" />
                <ui:VisualElement class="header-title">
                    <ui:Label class="header-title-highlight" name="lblShipDesignation" text="CVN" style="-unity-font-style: bold;"/>
                    <ui:Label name="lblShipName" text="PORTA-AVIÕES" style="-unity-font-style: bold;"/>
                </ui:VisualElement>
                <ui:Button name="btnClosePanel" class="close-btn" text="X" />
            </ui:VisualElement>

            <ui:ScrollView class="sections-container" name="sectionsContainer">
                <!-- Preenchido via C# -->
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- PAINEL INFERIOR TÁTICO -->
        <ui:VisualElement class="bottom-panel" name="bottomMenu">
            <ui:VisualElement class="unit-header">
                <ui:VisualElement class="unit-title-area">
                    <ui:Label class="unit-icon-large" name="bmIcon" text="[ FLT ]" />
                    <ui:VisualElement>
                        <ui:Label class="unit-title" name="bmTitle" text="F-35 LIGHTNING II" style="-unity-font-style: bold;"/>
                        <ui:Label class="unit-subtitle" name="bmStatus" text="STATUS: STANDBY // DECK" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="btnCloseBottom" class="close-btn" text="X" style="position: relative; top: 0; right: 0;"/>
            </ui:VisualElement>

            <ui:VisualElement class="status-grid">
                <ui:VisualElement class="stat-block">
                    <ui:VisualElement class="stat-labels">
                        <ui:Label class="stat-label-text" text="INTEGRIDADE ESTRUTURAL" />
                        <ui:Label class="stat-val" name="bmHpText" text="100/100" />
                    </ui:VisualElement>
                    <ui:VisualElement class="progress-bg">
                        <ui:VisualElement class="progress-fill fill-hp" name="bmHpBar" style="width: 100%;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                
                <ui:VisualElement class="stat-block" style="margin-right: 0;">
                    <ui:VisualElement class="stat-labels">
                        <ui:Label class="stat-label-text" text="SUPRIMENTO / COMBUSTÍVEL" />
                        <ui:Label class="stat-val" name="bmFuelText" text="100%" />
                    </ui:VisualElement>
                    <ui:VisualElement class="progress-bg">
                        <ui:VisualElement class="progress-fill fill-fuel" name="bmFuelBar" style="width: 100%;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="commands-grid" name="bmCommands">
                <!-- Injetado via C# -->
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Container de Alertas -->
        <ui:VisualElement class="toast-container" name="toastContainer" picking-mode="Ignore"/>
    </ui:VisualElement>
</ui:UXML>

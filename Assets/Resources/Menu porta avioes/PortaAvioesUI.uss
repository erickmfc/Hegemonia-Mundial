/* ─── Color Palette (Literal fallbacks for maximum compatibility in Unity USS) ─── */

/* ─── Side Panel ─── */
.carrier-panel {
    width: 200px;
    top: 34px;
    bottom: 0px;
    background-color: rgba(6, 12, 20, 0.97);
    border-right-width: 1px;
    border-right-color: #1a3352;
    flex-direction: column;
    position: absolute;
    left: 0px;
}

/* ─── Header ─── */
.header {
    padding: 7px 10px;
    border-bottom-width: 1px;
    border-bottom-color: #29a8e0;
    background-color: #04080f;
}

.gov-seal {
    font-size: 7px;
    color: #4e6580;
    margin-bottom: 2px;
    letter-spacing: 1px;
}

.header-title {
    font-size: 13px;
    color: #dce8f5;
    flex-direction: row;
    align-items: center;
}

.header-title-highlight {
    color: #29a8e0;
    margin-right: 4px;
}

.close-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    background-color: transparent;
    color: #e03c3c;
    border-width: 1px;
    border-color: #e03c3c;
    width: 18px;
    height: 18px;
    justify-content: center;
    align-items: center;
    font-size: 9px;
    cursor: pointer;
    transition-duration: 0.12s;
}

.close-btn:hover {
    background-color: #e03c3c;
    color: #ffffff;
}

/* ─── Scroll Area ─── */
.sections-container {
    flex-grow: 1;
    padding: 6px;
    flex-direction: column;
}

/* ─── Section ─── */
.section {
    border-width: 1px;
    border-color: #1a3352;
    background-color: rgba(0, 0, 0, 0.35);
    margin-bottom: 6px;
    flex-direction: column;
}

.section-title {
    padding: 4px 8px;
    font-size: 9px;
    color: #29a8e0;
    border-bottom-width: 1px;
    border-bottom-color: #1a3352;
    background-color: rgba(41, 168, 224, 0.05);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

/* ─── List Item ─── */
.list-item {
    padding: 4px 6px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(26, 51, 82, 0.3);
    transition-duration: 0.12s;
}

.list-item:hover {
    background-color: rgba(26, 51, 82, 0.22);
}

.unit-name-container {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    overflow: hidden;
}

.unit-name {
    font-size: 10px;
    color: #dce8f5;
    overflow: hidden;
    text-overflow: ellipsis;
}

.unit-name:hover { 
    color: #ffffff; 
}

.unit-designation {
    font-size: 7px;
    color: #d9900b;
    border-width: 1px;
    border-color: #d9900b;
    padding: 1px 2px;
    margin-right: 5px;
    -unity-font-style: bold;
}

.unit-status {
    font-size: 8px;
    color: #0da86e;
}

/* ─── Buttons ─── */
.btn {
    background-color: transparent;
    border-width: 1px;
    border-color: #1a3352;
    color: #dce8f5;
    padding: 3px 6px;
    font-size: 8px;
    transition-duration: 0.12s;
    cursor: pointer;
}

.btn:hover {
    background-color: #1e3d63;
    border-color: #29a8e0;
}

.btn:disabled { 
    opacity: 0.3; 
}

.btn-action { 
    color: #29a8e0; 
    border-color: #29a8e0; 
}
.btn-action:hover { 
    background-color: #29a8e0; 
    color: #000000; 
}

.btn-critical { 
    color: #d9900b; 
    border-color: #d9900b; 
}
.btn-critical:hover { 
    background-color: #d9900b; 
    color: #000000; 
}

.btn-danger { 
    color: #e03c3c; 
    border-color: #e03c3c; 
}
.btn-danger:hover { 
    background-color: #e03c3c; 
    color: #ffffff; 
}

/* ─── Deck buy button ─── */
.deck-controls {
    padding: 5px;
    background-color: rgba(0, 0, 0, 0.4);
    border-bottom-width: 1px;
    border-bottom-color: #1a3352;
}

.btn-buy-drone {
    width: 100%;
    padding: 4px;
    font-size: 9px;
}

/* ─── Bottom Panel ─── */
.bottom-panel {
    position: absolute;
    bottom: 14px;
    left: 50%;
    /* Use margin-left to center since translate: -50% 0 is sometimes buggy or unsupported in USS */
    margin-left: -240px; 
    width: 480px;
    background-color: rgba(6, 12, 20, 0.97);
    border-width: 1px;
    border-color: #1a3352;
    border-top-width: 2px;
    border-top-color: #29a8e0;
    padding: 10px;
    flex-direction: column;
    display: none;
}

.bottom-panel.active { 
    display: flex; 
}

.unit-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(26, 51, 82, 0.4);
    padding-bottom: 6px;
    margin-bottom: 8px;
}

.unit-title-area {
    flex-direction: row;
    align-items: center;
}

.unit-icon-large {
    font-size: 12px;
    color: #29a8e0;
    border-width: 1px;
    border-color: #29a8e0;
    padding: 4px 7px;
    background-color: rgba(41, 168, 224, 0.08);
    margin-right: 8px;
}

.unit-title { 
    font-size: 14px; 
    color: #dce8f5; 
}
.unit-subtitle { 
    font-size: 9px; 
    color: #4e6580; 
}

.status-grid {
    flex-direction: row;
    margin-bottom: 8px;
}

.stat-block {
    background-color: #03060b;
    border-width: 1px;
    border-color: #142133;
    padding: 5px;
    flex-direction: column;
    flex-grow: 1;
    margin-right: 6px;
}

.stat-labels {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 3px;
}

.stat-label-text { 
    font-size: 8px; 
    color: #4e6580; 
}
.stat-val { 
    color: #dce8f5; 
    font-size: 10px; 
}

.progress-bg {
    height: 4px;
    background-color: #0a0a0a;
    border-width: 1px;
    border-color: #1a1a1a;
    flex-direction: row;
}

.progress-fill { 
    height: 100%; 
    transition-duration: 0.2s; 
}
.fill-hp { 
    background-color: #0da86e; 
}
.fill-hp-low { 
    background-color: #e03c3c; 
}
.fill-fuel { 
    background-color: #29a8e0; 
}

.commands-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.cmd-btn {
    padding: 5px 8px;
    font-size: 9px;
    width: 49%;
    margin-right: 1%;
    margin-bottom: 5px;
}

.cmd-btn.full-width {
    width: 99%;
    margin-right: 0px;
}

/* ─── Toast ─── */
.toast-container {
    position: absolute;
    bottom: 12px;
    left: 255px;
    flex-direction: column;
    justify-content: flex-end;
}

.toast {
    background-color: rgba(0, 0, 0, 0.9);
    border-width: 1px;
    border-color: #1a3352;
    border-left-width: 3px;
    border-left-color: #29a8e0;
    color: #dce8f5;
    padding: 7px 12px;
    font-size: 10px;
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
    opacity: 1;
    transition-duration: 0.12s;
}

.toast-success { 
    border-color: #0da86e; 
    border-left-color: #0da86e; 
    color: #0da86e; 
}
.toast-error { 
    border-color: #e03c3c;  
    border-left-color: #e03c3c;  
    color: #e03c3c; 
}
.toast-warn { 
    border-color: #d9900b;  
    border-left-color: #d9900b; 
    color: #d9900b; 
}

/* Unity resets */
.unity-button {
    margin: 0px;
    border-radius: 0px;
}
.unity-scroll-view__content-container {
    flex-direction: column;
}
